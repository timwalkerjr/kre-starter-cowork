{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "heroBadge": {
      "type": "string"
    },
    "heroTitle": {
      "type": "string"
    },
    "heroSubtext": {
      "type": "string"
    },
    "heroTagline": {
      "type": "string"
    },
    "shortSummary": {
      "type": "string"
    },
    "mainImage": {
      "type": "string"
    },
    "projectDate": {
      "type": "string",
      "format": "date-time"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testimonial": {
      "type": "string"
    },
    "testimonialAuthor": {
      "type": "string"
    },
    "servicePerformed": {
      "type": "string"
    },
    "serviceArea": {
      "type": "string"
    },
    "overlayColor": {
      "type": "string"
    },
    "callToAction": {
      "type": "string"
    },
    "faqs": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoMetaDescription": {
      "type": "string"
    },
    "jsonLdSchema": {
      "type": "string"
    },
    "airtableRecordId": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}