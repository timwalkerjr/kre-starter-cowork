---
const serviceAreas = [
  { name: "Quakertown", url: "/armed-security-guards-quakertown-pa" },
  { name: "Coopersburg", url: "/armed-security-pa" },
  { name: "Center Valley", url: "/security-guards-pa" },
  { name: "Perkasie", url: "/armed-security-pa" },
  { name: "Sellersville", url: "/security-guards-pa" },
  { name: "Trumbaursville", url: "/armed-security-pa" },
  { name: "Spinnersville", url: "/security-guards-pa" },
  { name: "Zionhill", url: "/armed-security-pa" },
  { name: "Limeport", url: "/security-guards-pa" },
  { name: "East Greenville", url: "/armed-security-pa" },
];
---
<section class="bg-surface py-20" data-ps="armed-security-guards-quakertown-pa/QuakertownContent.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:2wg4v9">

    <div class="grid lg:grid-cols-2 gap-16 mb-20" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:2wg4va">

      <!-- Reviews -->
      <div class="reveal" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:2wg4vb">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19a8">
          [ Verified Reviews ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground mb-6"
          style="font-size: var(--text-h2); line-height: 1.1;"
         data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:4ynxtx">
          Our Quakertown Armed Security Guard Reviews
        </h2>
        <div class="space-y-4" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:2wg4vc">
          <a
            href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.9865777,17z"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 tactical-frame bg-background p-5 group hover:border-primary transition-colors duration-150"
           data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:kkz5yj">
            <span class="text-primary font-display font-bold text-2xl" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1a6">G</span>
            <div data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:2wg4vd">
              <p class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19a9">Google Maps Reviews</p>
              <p class="text-muted-foreground text-xs" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19aa">View our armed security guard reviews on Google</p>
            </div>
            <span class="ml-auto text-muted-foreground group-hover:text-primary transition-colors" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1a7">→</span>
          </a>
          <a
            href="https://www.bark.com/en/company/kre-security-investigations/9enON/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 tactical-frame bg-background p-5 group hover:border-primary transition-colors duration-150"
           data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:kkz5yk">
            <span class="text-primary font-display font-bold text-2xl" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1a8">B</span>
            <div data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtr">
              <p class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19ab">Bark.com Reviews</p>
              <p class="text-muted-foreground text-xs" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19ac">View our armed security guard reviews on Bark.com</p>
            </div>
            <span class="ml-auto text-muted-foreground group-hover:text-primary transition-colors" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1a9">→</span>
          </a>
        </div>
      </div>

      <!-- Service Areas -->
      <div class="reveal-right" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhts">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19ad">
          [ Coverage Zone ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground mb-6"
          style="font-size: var(--text-h2); line-height: 1.1;"
         data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:4ynxtw">
          Proudly Serving
        </h2>
        <div class="grid grid-cols-2 gap-2 mb-6" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtt">
          {serviceAreas.map(area => (
            <a
              href={area.url}
              class="flex items-center gap-2 text-muted-foreground hover:text-primary text-sm transition-colors duration-150 py-1"
             data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:kkz5z6">
              <span class="w-1.5 h-1.5 bg-primary flex-shrink-0" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1aa"></span>
              {area.name}
            </a>
          ))}
        </div>
        <p class="text-muted-foreground text-sm" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19ae">
          And surrounding cities —{" "}
          <a href="/" class="text-primary hover:underline" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:kkz5z7">View All Service Areas</a>
        </p>
      </div>
    </div>

    <!-- Location & Hours -->
    <div class="bg-dark-background p-8 lg:p-12 tactical-frame reveal" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtu">
      <div class="grid lg:grid-cols-2 gap-10" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtv">
        <div data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtw">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19af">
            [ Main Office ]
          </p>
          <h3 class="font-display font-bold uppercase text-dark-foreground text-xl mb-4" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:jn2v1i">KRE Security</h3>
          <div class="space-y-2 text-dark-muted-foreground text-sm mb-6" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtx">
            <p data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19ag">11 S 3rd St</p>
            <p data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19b2">Hamburg, PA 19526</p>
            <a href="tel:16105620971" class="block text-primary font-display font-bold text-lg hover:text-primary-hover transition-colors" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:kkz5z8">
              610-562-0971
            </a>
          </div>
          <a
            href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.9865777,17z"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block border border-dark-border text-dark-foreground font-display font-bold uppercase tracking-widest text-xs px-5 py-3 hover:border-primary hover:text-primary transition-colors duration-150"
           data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:kkz5z9">
            Get Driving Directions
          </a>
        </div>
        <div data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhty">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-4" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:dh19b3">
            [ Hours of Operation ]
          </p>
          <div class="space-y-2" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhtz">
            {[
              { day: "Monday", hours: "Open 24 Hours" },
              { day: "Tuesday", hours: "Open 24 Hours" },
              { day: "Wednesday", hours: "Open 24 Hours" },
              { day: "Thursday", hours: "Open 24 Hours" },
              { day: "Friday", hours: "Open 24 Hours" },
              { day: "Saturday", hours: "Closed" },
              { day: "Sunday", hours: "Closed" },
            ].map(({ day, hours }, __psIdx) => (
              <div class="flex justify-between items-center border-b border-dark-border pb-2" data-ps={`src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:99bhu0-${__psIdx}`}>
                <span class="text-dark-muted-foreground text-sm" data-ps={`src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1ab-${__psIdx}`}>{day}</span>
                <span class={`font-display font-bold text-xs uppercase tracking-wide ${hours === "Open 24 Hours" ? "text-primary" : "text-dark-muted-foreground"}`} data-ps={`src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:spa1ax-${__psIdx}`}>
                  {hours}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
