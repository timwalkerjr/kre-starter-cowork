---
const equipment = [
  "Firearm",
  "Taser Gun",
  "Expandable Baton",
  "Flashlight",
  "Handcuffs",
  "O.C. Spray",
  "Cell Phone",
];
---
<section class="bg-surface py-20" data-ps="armed-security-pa/ArmedSecurityContent.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="grid lg:grid-cols-2 gap-16 mb-20 items-start">

      <!-- Equipment & Credentials -->
      <div class="reveal">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Full Equipment Loadout ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground mb-6"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Our Armed Security Officers Carry:
        </h2>
        <div class="grid grid-cols-2 gap-3 mb-8">
          {equipment.map(item => (
            <div class="flex items-center gap-3 tactical-frame bg-background p-3">
              <span class="w-2 h-2 bg-primary flex-shrink-0"></span>
              <span class="font-display font-bold uppercase text-foreground text-sm">{item}</span>
            </div>
          ))}
        </div>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Our armed security officers are fully trained and certified in the use of all the equipment they carry. We offer plain clothes officers for an inconspicuous presence or black class A dress uniforms that give an authoritative visual appearance. Our armed security guard services can be employed for many uses from access control to personal protection.
        </p>
      </div>

      <!-- Images + NASRO badge -->
      <div class="space-y-6 reveal-right">
        <div class="tactical-frame bg-background p-4 flex items-center justify-center">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/pastedImage-249.webp"
            alt="National Association of School Resource Officers"
            class="max-w-[249px] h-auto object-contain"
            loading="lazy"
          />
        </div>
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_5cd7e3e1e5d84cc6a46b497a37fc813c~mv2-320.webp"
            alt="Armed security service companies PA"
            class="w-full max-w-[320px] mx-auto h-auto object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- Services offered -->
    <div class="bg-dark-background p-8 lg:p-12 tactical-frame mb-16 reveal">
      <div class="text-center mb-10">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Deployment Options ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-dark-foreground"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Armed Security for Any Situation
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { title: "Access Control", desc: "Professional armed presence at entry points and secured facilities." },
          { title: "Personal Protection", desc: "Dedicated armed officers for executive and personal protection assignments." },
          { title: "Plain Clothes Officers", desc: "Inconspicuous armed security presence for sensitive or low-profile situations." },
        ].map(service => (
          <div class="border border-dark-border p-5">
            <p class="text-primary font-display font-bold uppercase text-xs tracking-widest mb-2">[ Active ]</p>
            <h3 class="font-display font-bold uppercase text-dark-foreground text-base mb-3">{service.title}</h3>
            <p class="text-dark-muted-foreground text-sm leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <a
        href="/contact"
        class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-10 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
      >
        Contact Us Today to Get Started
      </a>
    </div>

  </div>
</section>
