---
---
<section id="contact-form" class="bg-dark-background py-20">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Left: Form -->
      <div class="reveal-left">
        <p class="font-display text-xs uppercase tracking-widest text-primary mb-3">
          [ Get A Quote ]
        </p>
        <h2 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-h2 mb-6">
          Contact Us
        </h2>
        <p class="font-sans text-dark-muted-foreground mb-8 text-sm leading-relaxed">
          Fill in your name, phone, email and we will contact you to discuss your security needs.
        </p>

        <form
          name="contact"
          method="POST"
          action="https://formspree.io/f/PASTE_ID_KRE_CONTACT"
          class="space-y-4"
        >
          <input type="hidden" name="_subject" value="KRE Security — Contact / Security Quote" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="first-name" class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2">
                First Name <span class="text-primary">*</span>
              </label>
              <input
                type="text"
                id="first-name"
                name="first-name"
                required
                class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground"
                placeholder="First name"
              />
            </div>
            <div>
              <label for="last-name" class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2">
                Last Name
              </label>
              <input
                type="text"
                id="last-name"
                name="last-name"
                class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground"
                placeholder="Last name"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2">
              Email <span class="text-primary">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground"
              placeholder="your@email.com"
            />
          </div>

          <div>
            <label for="message" class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground resize-none"
              placeholder="Describe your security needs..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
          >
            Submit Request
          </button>
        </form>
      </div>

      <!-- Right: Review links + social -->
      <div class="reveal-right">
        <div class="tactical-frame border-dark-border p-8 bg-secondary">
          <p class="font-display text-xs uppercase tracking-widest text-primary mb-3">
            [ Client Feedback ]
          </p>
          <h3 class="font-display font-bold text-dark-foreground text-h3 uppercase mb-4">
            Tell Us How We're Doing!
          </h3>
          <p class="font-sans text-dark-muted-foreground text-sm mb-8 leading-relaxed">
            We value our clients' opinions. Please take a moment to leave us a review on our Facebook or Google pages!
          </p>

          <div class="space-y-4">
            <a
              href="https://www.facebook.com/KREsecinvestigations/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 border border-dark-border px-5 py-4 hover:border-primary hover:bg-dark-background transition-colors group"
            >
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
              </svg>
              <span class="font-display font-bold text-dark-foreground text-xs uppercase tracking-widest group-hover:text-primary transition-colors">
                Review on Facebook
              </span>
            </a>

            <a
              href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.986583,17z"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 border border-dark-border px-5 py-4 hover:border-primary hover:bg-dark-background transition-colors group"
            >
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              <span class="font-display font-bold text-dark-foreground text-xs uppercase tracking-widest group-hover:text-primary transition-colors">
                Review on Google
              </span>
            </a>
          </div>

          <!-- Map address -->
          <div class="mt-8 pt-8 border-t border-dark-border">
            <p class="font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-3">
              [ Main Office ]
            </p>
            <address class="not-italic font-sans text-dark-foreground text-sm leading-relaxed">
              16600 Pottsville Pike<br />
              Hamburg, PA 19526
            </address>
            <a
              href="https://maps.google.com/?q=KRE+Security+LLC,+16600+Pottsville+Pike,+Hamburg,+PA+19526"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-3 font-display text-xs uppercase tracking-widest text-primary hover:text-primary-hover transition-colors"
            >
              Get Directions →
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
