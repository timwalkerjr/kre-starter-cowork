---
const offices = [
  {
    name: "KRE Security Main Office",
    address: "16600 Pottsville Pike",
    city: "Hamburg, PA 19526",
    phone: "610-562-0971",
    note: "Emergency Security Guard Services",
    dark: false,
  },
  {
    name: "KRE Security LLC — Reading Office",
    address: "530 Walnut Street, 1st Floor Ste. 2",
    city: "Reading, PA 19601",
    phone: "610-562-0971",
    note: "Appointment Only",
    dark: false,
  },
  {
    name: "Harrisburg / Susquehanna Valley Regional Office",
    address: "3405 North 6th Street, Suite 204",
    city: "Harrisburg, PA 17110",
    phone: "717-480-2961",
    fax: "484-660-3571",
    note: "Walk-in Appointments Are Welcomed!",
    dark: false,
  },
];

const regionalLines = [
  { region: "Allentown / Bethlehem / Easton", phone: "610-562-0971" },
  { region: "Lancaster / Lebanon County", phone: "717-450-7632" },
  { region: "Reading / Pottstown Office", phone: "610-562-0971" },
  { region: "Schuylkill County", phone: "570-399-1010" },
  { region: "Investigations", phone: "610-562-0971" },
];
---

<section class="bg-surface py-20 border-b border-border">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-12 reveal">
      <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-2">[ Office Locations ]</p>
      <h2 class="font-display font-bold uppercase tracking-tight text-foreground text-h2">
        Our Pennsylvania Offices
      </h2>
    </div>

    <!-- Office cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {offices.map((office, i) => (
        <div class="tactical-frame p-6 bg-background reveal" style={`transition-delay: ${i * 0.1}s`}>
          <p class="font-display text-xs uppercase tracking-widest text-primary mb-3">
            {office.note}
          </p>
          <h3 class="font-display font-bold text-foreground text-base uppercase mb-3 leading-tight">
            {office.name}
          </h3>
          <address class="not-italic font-sans text-muted-foreground text-sm mb-4 leading-relaxed">
            {office.address}<br />
            {office.city}
          </address>
          <a
            href={`tel:${office.phone.replace(/-/g, "")}`}
            class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide"
          >
            {office.phone}
          </a>
          {office.fax && (
            <p class="font-sans text-muted-foreground text-xs mt-1">
              Fax: {office.fax}
            </p>
          )}
        </div>
      ))}
    </div>

    <!-- Regional hotlines -->
    <div class="border border-border bg-background p-8 reveal">
      <div class="flex items-center gap-3 mb-6">
        <span class="status-dot">[ Regional Dispatch Lines ]</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {regionalLines.map((line) => (
          <div class="flex items-center justify-between border-b border-border pb-3">
            <span class="font-sans text-sm text-muted-foreground">{line.region}</span>
            <a
              href={`tel:${line.phone.replace(/-/g, "")}`}
              class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm ml-4 shrink-0"
            >
              {line.phone}
            </a>
          </div>
        ))}
      </div>

      <!-- Emergency line -->
      <div class="mt-6 pt-6 border-t border-border text-center">
        <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-2">
          24-Hour Emergency Contact
        </p>
        <a
          href="tel:6105620971"
          class="font-display font-bold text-h3 text-primary hover:text-primary-hover transition-colors uppercase tracking-wide"
        >
          610-562-0971
        </a>
        <p class="font-sans text-xs text-muted-foreground mt-1 uppercase tracking-widest">
          Free Consultations Available
        </p>
      </div>
    </div>

    <!-- Payment note -->
    <p class="text-center font-sans text-sm text-muted-foreground mt-6 reveal">
      We accept Cash, Check, and major payment methods.
    </p>

  </div>
</section>
