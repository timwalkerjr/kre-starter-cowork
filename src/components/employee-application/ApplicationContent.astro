---
---
<section class="bg-background py-20">
  <div class="max-w-4xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <p class="status-dot justify-center mb-4">[ Now Hiring ]</p>
      <h1 class="font-display font-bold uppercase tracking-tight text-foreground text-h1 mb-4">
        Employee Hiring Application
      </h1>
    </div>

    <!-- Disclaimer -->
    <div class="tactical-frame bg-surface border-border p-8 mb-10 reveal">
      <p class="font-display text-xs uppercase tracking-widest text-primary mb-3">
        [ KRE Disclaimer ]
      </p>
      <p class="font-sans text-foreground text-sm leading-relaxed">
        KRE Security, working under the laws of the Commonwealth of Pennsylvania will not employ any individual convicted of a Felony. A conviction is an immediate disqualification of an employment opportunity in the capacity of a Security Guard in the Commonwealth.
      </p>
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <p class="font-sans text-muted-foreground text-sm mb-6">
        Click below to begin your online employment application through our secure Adobe Sign portal.
      </p>
      <a
        href="https://na4.documents.adobe.com/public/esignWidget?wid=CBFCIBAA3AAABLblqZhDVu8TUeWmiMKm9oE1_hjixjqhIuSb3EtQyMD2mPlOX7QUF0PNlNIISYZ0f9woOk40*"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-10 py-5 border-2 border-primary hover:bg-primary-hover transition-colors"
      >
        Click Here to Start Application
      </a>
      <p class="font-sans text-muted-foreground text-xs mt-4">
        Opens in a new window via Adobe Sign
      </p>
    </div>

    <!-- Contact info -->
    <div class="mt-16 border border-border bg-surface p-8 text-center reveal">
      <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-2">
        [ Questions? Contact Us ]
      </p>
      <p class="font-sans text-foreground text-sm mb-4">
        For questions about available positions, contact our hiring team.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="tel:6105620971" class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide">
          610-562-0971 Ext: 3
        </a>
        <a href="mailto:employment@kresecurity.com" class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide">
          employment@kresecurity.com
        </a>
      </div>
    </div>

  </div>
</section>
