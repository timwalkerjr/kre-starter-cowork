---
---
<section class="bg-dark-background py-20">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <!-- Application info -->
      <div class="reveal-left">
        <p class="font-display text-xs uppercase tracking-widest text-primary mb-3">
          [ Apply Now ]
        </p>
        <h2 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-h2 mb-6">
          KRE Employee Application
        </h2>
        <p class="font-sans text-dark-muted-foreground text-sm leading-relaxed mb-8">
          KRE Security has proudly served Eastern Pennsylvania since 1990 and continues to provide professional, first-class security services. Our team includes PA Act 235 certified officers, as well as retired and off-duty law enforcement officers.
        </p>

        <a
          href="https://na4.documents.adobe.com/public/esignWidget?wid=CBFCIBAA3AAABLblqZhDVu8TUeWmiMKm9oE1_hjixjqhIuSb3EtQyMD2mPlOX7QUF0PNlNIISYZ0f9woOk40*"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors mb-8"
        >
          Start Online Application
        </a>

        <div class="border-t border-dark-border pt-8">
          <p class="font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-4">
            [ Additional Submission Methods ]
          </p>
          <div class="space-y-3 font-sans text-dark-muted-foreground text-sm leading-relaxed">
            <p>
              Applications and resumes may also be submitted via:
            </p>
            <div class="space-y-2 pl-4">
              <p><span class="text-primary font-bold">Email:</span> <a href="mailto:employment@kresecurity.com" class="hover:text-primary transition-colors">employment@kresecurity.com</a></p>
              <p><span class="text-primary font-bold">Fax:</span> 484-660-3571</p>
              <p><span class="text-primary font-bold">In Person:</span> 16600 Pottsville Pike, Hamburg, PA 19526<br />
              <span class="text-dark-muted-foreground text-xs">Monday to Friday, 9 AM – 6 PM. Just stop in.</span></p>
              <p><span class="text-primary font-bold">Mail to:</span><br />
              KRE Security LLC.<br />
              Attn: Employment<br />
              16600 Pottsville Pike<br />
              Hamburg, PA 19526</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Image + contact card -->
      <div class="reveal-right">
        <div class="mb-6">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/image-3-320.webp"
            alt="KRE Security officer"
            class="max-w-[320px] h-auto object-cover border border-dark-border"
            loading="lazy"
          />
        </div>

        <div class="tactical-frame border-dark-border bg-secondary p-6">
          <p class="font-display text-xs uppercase tracking-widest text-primary mb-3">[ Hiring Office ]</p>
          <h3 class="font-display font-bold text-dark-foreground uppercase text-sm mb-4">
            Questions About Positions?
          </h3>
          <div class="space-y-3 font-sans text-dark-muted-foreground text-sm">
            <p>
              Interested applicants may call us and a member of our hiring team will return your call.
            </p>
            <a
              href="tel:6105620971"
              class="block font-display font-bold text-dark-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide mt-2"
            >
              610-562-0971 Ext: 3
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
