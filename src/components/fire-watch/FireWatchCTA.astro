---
---
<section id="fire-watch-cta" class="py-16 lg:py-20 border-t border-dark-border" style="background-color: var(--color-dark-background);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
    <div class="mb-4">
      <span class="status-dot">[ Ready to Respond ]</span>
    </div>
    <h2 class="font-display font-bold uppercase tracking-tight mb-4 reveal"
        style="font-size: var(--text-h2); line-height: 1.1; color: var(--color-dark-foreground);">
      Protect Your Property<br />with Fire Watch Services
    </h2>
    <p class="max-w-xl mx-auto mb-8 leading-relaxed reveal reveal-delay-1"
       style="color: var(--color-dark-muted-foreground);">
      Contact KRE Security today to schedule professional fire watch services for your facility in Eastern Pennsylvania.
    </p>
    <a
      href="/contact/"
      class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-8 py-3 transition-colors duration-150 reveal reveal-delay-2"
      style="border-color: var(--color-primary); background-color: var(--color-primary); color: var(--color-primary-foreground);"
      onmouseover="this.style.backgroundColor='var(--color-primary-hover)'; this.style.borderColor='var(--color-primary-hover)';"
      onmouseout="this.style.backgroundColor='var(--color-primary)'; this.style.borderColor='var(--color-primary)';"
    >
      Contact Us Today to Get Started
    </a>
  </div>
</section>
