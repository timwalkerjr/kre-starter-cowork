---
---
<section id="first-aid-hero" class="bg-dark-background py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div>
        <div class="mb-6">
          <span class="status-dot">[ Certification Programs: Active ]</span>
        </div>
        <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 reveal"
            style="font-size: var(--text-h1); line-height: 1.05;">
          First Aid, CPR<br />&amp; AED Training
        </h1>
        <p class="text-lg text-dark-muted-foreground leading-relaxed mb-8 reveal reveal-delay-1">
          KRE Security LLC. offers custom based CPR/First Aid and AED Training for your business, facility, or civic and private groups. We can get you or your group certified!
        </p>
        <div class="flex flex-wrap gap-4 reveal reveal-delay-2">
          <a href="#first-aid-form"
             class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150"
             style="border-color: var(--color-primary); background-color: var(--color-primary); color: var(--color-primary-foreground);">
            Request a Training Quote
          </a>
          <a href="tel:6105620971"
             class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150"
             style="border-color: var(--color-dark-border); color: var(--color-dark-foreground);">
            610-562-0971
          </a>
        </div>
      </div>

      <!-- Certification Logos -->
      <div class="flex flex-col gap-6 items-start reveal-right">
        <div class="border border-dark-border p-6 w-full" style="background-color: var(--color-secondary);">
          <p class="text-xs font-display font-bold uppercase tracking-widest mb-4" style="color: var(--color-primary);">
            [ Approved By ]
          </p>
          <div class="flex flex-wrap gap-6 items-center">
            <img
              src="https://pagesmith-cdn.com/d22f750a/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~mv2-110.webp"
              alt="American Red Cross training"
              class="h-10 w-auto object-contain"
              loading="eager"
            />
            <img
              src="https://pagesmith-cdn.com/d22f750a/images/39725c_83d9d70bec11400db248ad3e6c07da4b~mv2.gif"
              alt="American Heart Association training"
              class="h-10 w-auto object-contain"
              loading="eager"
            />
          </div>
          <p class="text-sm mt-4 leading-relaxed" style="color: var(--color-dark-muted-foreground);">
            Courses approved by the American Heart Association and American Red Cross for healthcare providers and lay rescuers.
          </p>
        </div>

        <div class="border-l-2 pl-4" style="border-color: var(--color-primary);">
          <p class="text-sm font-display font-bold uppercase tracking-wide text-dark-foreground mb-1">
            35+ Years of Teaching Experience
          </p>
          <p class="text-sm" style="color: var(--color-dark-muted-foreground);">
            Our staff brings over 35 years of field and academic teaching knowledge.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
