---
import Container from '@/components/Container.astro';

const benefits = [
  {
    num: "01",
    title: "Sense of Security",
    desc: "Even just the presence of a security guard can make a business more effective and efficient by giving the owners and employees peace of mind."
  },
  {
    num: "02",
    title: "Prevention",
    desc: "A thief will think twice when there is a security guard present. It lets them know that you are serious about the security of your business and will deter them from targeting you."
  },
  {
    num: "03",
    title: "Customer Service",
    desc: "Not only does a sense of security put your employees at ease but also your customers."
  },
  {
    num: "04",
    title: "Handling Crime",
    desc: "Having a security guard will deter crime in your business but it may still happen; having security measures in place will allow police to solve a crime quickly and get you back to business in no time!"
  },
  {
    num: "05",
    title: "Monitoring",
    desc: "Take this responsibility off of your shoulders and leave your business security to a professional security guard company."
  }
];
---

<section id="advantages" class="bg-dark-background py-20 lg:py-32 overflow-hidden" data-ps="src/components/home/Advantages.astro:1dvuf4">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start" data-ps="src/components/home/Advantages.astro:jvof9u">
      <div class="lg:col-span-5" data-ps="src/components/home/Advantages.astro:jvof9t">
        <div class="status-dot mb-4" data-ps="src/components/home/Advantages.astro:jvof9s">TACTICAL ADVANTAGE</div>
        <h2 class="text-h2 text-dark-foreground mb-8" data-ps="src/components/home/Advantages.astro:b77rse">5 Benefits of Hiring a Security Company</h2>
        <div class="space-y-12" data-ps="src/components/home/Advantages.astro:jvof9r">
          {benefits.map(benefit => (
            <div class="reveal border-l-2 border-primary/30 pl-8 relative py-2" data-ps="src/components/home/Advantages.astro:jvof9q">
              <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-dark-background border-2 border-primary" data-ps="src/components/home/Advantages.astro:jvof9p"></div>
              <div class="text-primary font-display font-bold text-sm tracking-widest mb-2" data-ps="src/components/home/Advantages.astro:jvof9o">{benefit.num}</div>
              <h3 class="text-xl font-bold font-display text-dark-foreground mb-3" data-ps="src/components/home/Advantages.astro:3h75f8">{benefit.title}</h3>
              <p class="text-dark-muted-foreground text-sm leading-relaxed max-w-md" data-ps="src/components/home/Advantages.astro:edii7j">{benefit.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-7 lg:sticky lg:top-32" data-ps="src/components/home/Advantages.astro:jvof9n">
        <div class="tactical-frame p-2 bg-secondary border-dark-border overflow-hidden" data-ps="src/components/home/Advantages.astro:jvof9m">
          <div class="relative aspect-[3/4] lg:aspect-[4/5]" data-ps="src/components/home/Advantages.astro:jvof9l">
            <img 
              src="https://pagesmith-cdn.com/d22f750a/images/The-Buck-photo-320.webp" 
              alt="Professional Security Guard" 
              class="w-full h-full object-cover grayscale brightness-75 hover:grayscale-0 hover:brightness-100 transition-all duration-1000"
              width="320"
              height="430" data-ps="src/components/home/Advantages.astro:mdxjlx" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-transparent to-transparent opacity-60" data-ps="src/components/home/Advantages.astro:d3u6up"></div>
            <div class="absolute bottom-10 left-10" data-ps="src/components/home/Advantages.astro:d3u6uq">
              <div class="text-primary font-display font-bold text-[10px] tracking-[0.3em] uppercase mb-2" data-ps="src/components/home/Advantages.astro:d3u6ur">Field Operations</div>
              <h3 class="text-h3 text-dark-foreground" data-ps="src/components/home/Advantages.astro:3h75f7">Protection Excellence</h3>
            </div>
          </div>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-4" data-ps="src/components/home/Advantages.astro:d3u6us">
           <div class="bg-dark-border/30 p-6 border-l-2 border-primary" data-ps="src/components/home/Advantages.astro:d3u6ut">
             <div class="text-h2 text-dark-foreground tracking-tighter" data-ps="src/components/home/Advantages.astro:d3u6uu">24/7</div>
             <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mt-1" data-ps="src/components/home/Advantages.astro:d3u6uv">Readiness</div>
           </div>
           <div class="bg-dark-border/30 p-6 border-l-2 border-primary" data-ps="src/components/home/Advantages.astro:d3u6uw">
             <div class="text-h2 text-dark-foreground tracking-tighter" data-ps="src/components/home/Advantages.astro:d3u6ux">100%</div>
             <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mt-1" data-ps="src/components/home/Advantages.astro:d3u6uy">Compliance</div>
           </div>
        </div>
      </div>
    </div>
  </Container>
</section>
