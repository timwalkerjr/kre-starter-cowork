---
import Container from '@/components/Container.astro';
---

<section id="contact" class="bg-dark-background py-20 lg:py-32" data-ps="src/components/home/ContactForm.astro:hrgilq">
  <Container>
    <div class="tactical-frame bg-secondary border-dark-border p-8 lg:p-16" data-ps="src/components/home/ContactForm.astro:fufm9l">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16" data-ps="src/components/home/ContactForm.astro:fufm9k">
        <div class="lg:col-span-5" data-ps="src/components/home/ContactForm.astro:fufm9j">
          <div class="status-dot mb-4" data-ps="src/components/home/ContactForm.astro:fufm9i">DISPATCH PORTAL</div>
          <h2 class="text-h2 text-dark-foreground mb-8" data-ps="src/components/home/ContactForm.astro:f1qe6g">Contact Us Today for a Security Service Quote</h2>
          <p class="text-dark-muted-foreground mb-12" data-ps="src/components/home/ContactForm.astro:p5uxuc">
            Professional protection begins with a tailored assessment. Connect with our regional headquarters to discuss your security requirements.
          </p>

          <div class="space-y-8" data-ps="src/components/home/ContactForm.astro:fufm9h">
            <div class="flex gap-4 items-start" data-ps="src/components/home/ContactForm.astro:fufm9g">
              <div class="w-10 h-10 border border-primary flex items-center justify-center flex-shrink-0" data-ps="src/components/home/ContactForm.astro:fufm9f">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div data-ps="src/components/home/ContactForm.astro:fufm9e">
                <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mb-1" data-ps="src/components/home/ContactForm.astro:fufm9d">Emergency Dispatch</div>
                <a href="tel:610-562-0971" class="text-2xl font-display font-bold text-dark-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/home/ContactForm.astro:i1x14j">610-562-0971</a>
              </div>
            </div>

            <div class="flex gap-4 items-start" data-ps="src/components/home/ContactForm.astro:9ocn1j">
              <div class="w-10 h-10 border border-primary flex items-center justify-center flex-shrink-0" data-ps="src/components/home/ContactForm.astro:9ocn1i">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div data-ps="src/components/home/ContactForm.astro:9ocn1h">
                <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mb-1" data-ps="src/components/home/ContactForm.astro:9ocn1g">Main Office</div>
                <p class="text-sm text-dark-muted-foreground leading-relaxed" data-ps="src/components/home/ContactForm.astro:p5uxub">
                  16600 Pottsville Pike<br />
                  Hamburg, PA 19526<br />
                  <a href="tel:610-562-0971" class="text-dark-foreground hover:text-primary no-underline font-bold">610-562-0971</a>
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 border border-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mb-1">Harrisburg Regional Office</div>
                <p class="text-sm text-dark-muted-foreground leading-relaxed">
                  3405 North 6th Street, Suite 204<br />
                  Harrisburg, PA 17110<br />
                  <a href="tel:717-480-2961" class="text-dark-foreground hover:text-primary no-underline font-bold">717-480-2961</a>
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 border border-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mb-1">Email Us</div>
                <div class="space-y-1 text-sm text-dark-muted-foreground">
                  <div>General: <a href="mailto:jemes@kresecurity.com" class="text-dark-foreground hover:text-primary no-underline">jemes@kresecurity.com</a></div>
                  <div>Billing: <a href="mailto:financial@kresecurity.com" class="text-dark-foreground hover:text-primary no-underline">financial@kresecurity.com</a></div>
                  <div>Scheduling: <a href="mailto:scheduling@kresecurity.com" class="text-dark-foreground hover:text-primary no-underline">scheduling@kresecurity.com</a></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7" data-ps="src/components/home/ContactForm.astro:9ocn1f">
          <form class="space-y-6" action="/psapi-internal-v1/forms/submit" method="POST">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/components/home/ContactForm.astro:9ocn1e">
              <div class="space-y-2" data-ps="src/components/home/ContactForm.astro:9ocn1d">
                <label for="first-name" class="text-[10px] font-display font-bold text-primary uppercase tracking-widest" data-ps="src/components/home/ContactForm.astro:5gyyqa">First Name *</label>
                <input type="text" id="first-name" name="first_name" required class="w-full bg-dark-background border border-dark-border p-4 text-dark-foreground focus:border-primary outline-none transition-colors" />
              </div>
              <div class="space-y-2" data-ps="src/components/home/ContactForm.astro:9ocn1c">
                <label for="last-name" class="text-[10px] font-display font-bold text-primary uppercase tracking-widest" data-ps="src/components/home/ContactForm.astro:5gyyq9">Last Name</label>
                <input type="text" id="last-name" name="last_name" class="w-full bg-dark-background border border-dark-border p-4 text-dark-foreground focus:border-primary outline-none transition-colors" />
              </div>
            </div>
            <div class="space-y-2" data-ps="src/components/home/ContactForm.astro:9ocn1b">
              <label for="email" class="text-[10px] font-display font-bold text-primary uppercase tracking-widest" data-ps="src/components/home/ContactForm.astro:5gyyq8">Email *</label>
              <input type="email" id="email" name="email" required class="w-full bg-dark-background border border-dark-border p-4 text-dark-foreground focus:border-primary outline-none transition-colors" />
            </div>
            <div class="space-y-2" data-ps="src/components/home/ContactForm.astro:9ocn1a">
              <label for="message" class="text-[10px] font-display font-bold text-primary uppercase tracking-widest" data-ps="src/components/home/ContactForm.astro:5gyyq7">Message</label>
              <textarea id="message" name="message" rows="5" class="w-full bg-dark-background border border-dark-border p-4 text-dark-foreground focus:border-primary outline-none transition-colors resize-none"></textarea>
            </div>
            <button type="submit" class="w-full md:w-auto px-12 py-5 bg-primary text-primary-foreground font-display font-bold uppercase tracking-[0.2em] hover:bg-primary-hover transition-all" data-ps="src/components/home/ContactForm.astro:n0ol6k">
              Submit Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </Container>
</section>
