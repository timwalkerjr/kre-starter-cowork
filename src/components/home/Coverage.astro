---
import Container from '@/components/Container.astro';

const locations = [
  { county: "Berks", cities: "Hamburg, Reading, Wyomissing, Boyertown, Kutztown, Temple, Leesport, Boyertown, Wernersville" },
  { county: "Bucks", cities: "Levittown, Quakertown, Doylestown" },
  { county: "Carbon", cities: "Jim Thorpe, Lehighton, Nesquehoning" },
  { county: "Chester", cities: "West Chester, Phoenixville, Downingtown, Coatesville, Kennett Square" },
  { county: "Cumberland", cities: "Carlisle" },
  { county: "Dauphin", cities: "Harrisburg, Hershey, Colonial Park, Middletown" },
  { county: "Erie", cities: "Erie" },
  { county: "Franklin", cities: "Fannettsburg" },
  { county: "Juniata", cities: "Port Royal, Mifflintown" },
  { county: "Lancaster", cities: "Lancaster, Ephrata, Elizabethtown, Lititz, Columbia, New Holland, Ephrata" },
  { county: "Lebanon", cities: "Lebanon, Palmyra, Annville, Hershey" },
  { county: "Lehigh", cities: "Allentown, Bethlehem, Emmaus, Whitehall, Fogelsville" },
  { county: "Luzerne", cities: "Wilkes-Barre" },
  { county: "Monroe", cities: "Kunkletown, East Stroudsburg" },
  { county: "Montgomery", cities: "Norristown, Pottstown, King of Prussia, Lansdale, Willow Grove" },
  { county: "Northampton", cities: "Easton, Northampton, Palmer" },
  { county: "Northumberland", cities: "Sunbury, Shamokin, Elysburg" },
  { county: "Perry", cities: "Newport" },
  { county: "Philadelphia", cities: "Center City and Surrounding City Limits" },
  { county: "Schuylkill", cities: "Pottsville, Tamaqua, Minersville, Shenandoah, Cressona, Deer Lake, Port Carbon, Schuylkill Haven" },
  { county: "Union", cities: "Lewisburg" },
  { county: "Wayne", cities: "Honesdale" }
];
---

<section id="coverage" class="bg-background py-20 lg:py-32" data-ps="src/components/home/Coverage.astro:mcpjq5">
  <Container>
    <div class="flex flex-col lg:flex-row justify-between items-end gap-8 mb-16" data-ps="src/components/home/Coverage.astro:42a3jq">
      <div class="max-w-2xl" data-ps="src/components/home/Coverage.astro:42a3jr">
        <div class="status-dot mb-4" data-ps="src/components/home/Coverage.astro:dm7fdb">REGIONAL COVERAGE</div>
        <h2 class="text-h2 text-foreground mb-6" data-ps="src/components/home/Coverage.astro:3eqqph">Major Cities Covered By KRE Security LLC.</h2>
        <p class="text-muted-foreground" data-ps="src/components/home/Coverage.astro:log9bi">
          Our PA security company provides qualified law enforcement and investigative services across 22+ counties, ensuring professional protection in the following key regions.
        </p>
      </div>
      <a href="/contact" class="px-8 py-4 border-2 border-foreground text-foreground font-display font-bold text-xs uppercase tracking-widest hover:bg-foreground hover:text-background transition-all no-underline" data-ps="src/components/home/Coverage.astro:sse60j">
        View Service Area Map
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start" data-ps="src/components/home/Coverage.astro:dm7fda">
      <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10" data-ps="src/components/home/Coverage.astro:dm7fd9">
        {locations.map(loc => (
          <div class="reveal border-b border-border pb-8" data-ps="src/components/home/Coverage.astro:dm7fd8">
            <h3 class="text-lg font-bold font-display text-foreground mb-2 flex justify-between items-center" data-ps="src/components/home/Coverage.astro:i35nx2">
              {loc.county} County
              <span class="w-1.5 h-1.5 rounded-full bg-primary" data-ps="src/components/home/Coverage.astro:8wbur0"></span>
            </h3>
            <p class="text-muted-foreground text-xs leading-relaxed uppercase tracking-wider font-medium" data-ps="src/components/home/Coverage.astro:log9bj">
              {loc.cities}
            </p>
          </div>
        ))}
      </div>

      <div class="lg:col-span-4 lg:sticky lg:top-32" data-ps="src/components/home/Coverage.astro:dm7fd7">
        <div class="bg-surface p-8 border border-border" data-ps="src/components/home/Coverage.astro:dm7fd6">
          <img 
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_7c8af4347a884406b3e0eb9384b1e510~mv2-1024.webp" 
            alt="PA Security Service Map" 
            class="w-full h-auto object-contain mb-8 mix-blend-multiply" 
            width="1024"
            height="637" data-ps="src/components/home/Coverage.astro:1k0z88" />
          <div class="space-y-4" data-ps="src/components/home/Coverage.astro:dm7fd5">
            <div class="text-[10px] font-display font-bold text-primary tracking-widest uppercase mb-2">Regional Hotlines</div>
            <div class="space-y-3">
              <div>
                <div class="text-[9px] font-display font-bold text-muted-foreground uppercase tracking-wider">Allentown / Bethlehem / Easton</div>
                <a href="tel:610-562-0971" class="text-sm font-bold text-foreground no-underline hover:text-primary transition-colors">610-562-0971</a>
              </div>
              <div>
                <div class="text-[9px] font-display font-bold text-muted-foreground uppercase tracking-wider">Lancaster / Lebanon</div>
                <a href="tel:717-450-7632" class="text-sm font-bold text-foreground no-underline hover:text-primary transition-colors">717-450-7632</a>
              </div>
              <div>
                <div class="text-[9px] font-display font-bold text-muted-foreground uppercase tracking-wider">Reading / Pottstown</div>
                <a href="tel:610-223-3714" class="text-sm font-bold text-foreground no-underline hover:text-primary transition-colors">610-223-3714</a>
              </div>
              <div>
                <div class="text-[9px] font-display font-bold text-muted-foreground uppercase tracking-wider">Schuylkill County</div>
                <a href="tel:570-399-1010" class="text-sm font-bold text-foreground no-underline hover:text-primary transition-colors">570-399-1010</a>
              </div>
              <div>
                <div class="text-[9px] font-display font-bold text-muted-foreground uppercase tracking-wider">Harrisburg</div>
                <a href="tel:717-480-2961" class="text-sm font-bold text-foreground no-underline hover:text-primary transition-colors">717-480-2961</a>
              </div>
            </div>
            <div class="pt-3 border-t border-border flex justify-between items-center text-xs">
              <span class="font-display font-bold uppercase text-muted-foreground">Coverage</span>
              <span class="font-display font-bold uppercase text-foreground">22+ Counties</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
