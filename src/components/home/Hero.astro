---
import Container from '@/components/Container.astro';
---

<section id="hero" class="relative bg-secondary min-h-[80vh] flex items-center overflow-hidden" data-ps="src/components/home/Hero.astro:c6307">
  <!-- Dynamic Background with Gradient Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/home/Hero.astro:bg-container">
    <img 
      src="https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=1200"
      srcset="https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=480 480w, https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=768 768w, https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=1280 1280w, https://images.pexels.com/photos/19317897/pexels-photo-19317897.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w"
      sizes="100vw"
      alt="Security Operations Center"
      class="w-full h-full object-cover grayscale-[20%]"
      loading="eager"
      fetchpriority="high"
      crossorigin="anonymous" data-ps="src/components/home/Hero.astro:fibi7w" />
    <div class="absolute inset-0 bg-secondary/85 z-10" data-ps="src/components/home/Hero.astro:overlay-base"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-secondary via-secondary/40 to-secondary z-10" data-ps="src/components/home/Hero.astro:overlay-2"></div>
  </div>

  <Container class="relative z-20 py-16 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto" data-ps="src/components/home/Hero.astro:ecxgf4">
      <div class="status-dot mb-8 hero-animate text-primary justify-center" data-ps="src/components/home/Hero.astro:ecxgf6">OPERATIONAL STATUS: ACTIVE</div>
      
      <h1 class="text-h1 font-bold text-secondary-foreground mb-8 hero-animate hero-animate-delay-1 leading-tight tracking-tight" data-ps="src/components/home/Hero.astro:307k1s">
        PRECISION <span class="" data-ps="src/components/home/Hero.astro:z1i1wk">PROTECTION</span> <br />
        FOR THE COMMONWEALTH
      </h1>
      
      <p class="text-xl text-secondary-foreground/90 mb-12 max-w-2xl mx-auto hero-animate hero-animate-delay-2 leading-relaxed" data-ps="src/components/home/Hero.astro:6uykmz">
        KRE Security, LLC delivers comprehensive, licensed, and responsive security services that protect the people, property, and operations of every client we serve across Pennsylvania.
      </p>
      
      <div class="flex flex-wrap justify-center gap-6 hero-animate hero-animate-delay-3" data-ps="src/components/home/Hero.astro:ecxgf7">
        <a href="tel:610-562-0971" class="px-10 py-5 bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest no-underline hover:bg-primary-hover transition-all flex items-center gap-4 group" data-ps="src/components/home/Hero.astro:8zc2q">
          <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          24HR Emergency Dispatch
        </a>
        <a href="/employment" class="px-10 py-5 border-2 border-primary/40 text-secondary-foreground font-display font-bold uppercase tracking-widest no-underline hover:bg-primary/10 hover:border-primary transition-all flex items-center gap-3" data-ps="src/components/home/Hero.astro:8zc2r">
          Join Our Team
        </a>
      </div>

      <!-- Quick Stats / Badges -->
      <div class="mt-16 flex flex-wrap justify-center gap-12 border-t border-dark-border pt-10 hero-animate hero-animate-delay-4" data-ps="src/components/home/Hero.astro:stats">
        <div data-ps="src/components/home/Hero.astro:stat-1">
          <div class="text-primary font-display font-bold text-2xl mb-1" data-ps="src/components/home/Hero.astro:stat-val-1">EST. 2016</div>
          <div class="text-[10px] text-dark-muted-foreground uppercase tracking-[0.2em]" data-ps="src/components/home/Hero.astro:stat-label-1">Current Ownership</div>
        </div>
        <div data-ps="src/components/home/Hero.astro:stat-2">
          <div class="text-primary font-display font-bold text-2xl mb-1" data-ps="src/components/home/Hero.astro:stat-val-2">LIC. #84</div>
          <div class="text-[10px] text-dark-muted-foreground uppercase tracking-[0.2em]" data-ps="src/components/home/Hero.astro:stat-label-2">PA Certified Agency</div>
        </div>
        <div data-ps="src/components/home/Hero.astro:stat-3">
          <div class="text-primary font-display font-bold text-2xl mb-1" data-ps="src/components/home/Hero.astro:stat-val-3">STATEWIDE</div>
          <div class="text-[10px] text-dark-muted-foreground uppercase tracking-[0.2em]" data-ps="src/components/home/Hero.astro:stat-label-3">Operational Range</div>
        </div>
      </div>
    </div>
  </Container>

  <!-- Technical Corner Frame Motif -->
  <div class="absolute top-0 right-0 w-64 h-64 border-t-2 border-r-2 border-primary/20 pointer-events-none" data-ps="src/components/home/Hero.astro:motif-tr"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 border-b-2 border-l-2 border-primary/20 pointer-events-none" data-ps="src/components/home/Hero.astro:motif-bl"></div>
</section>
