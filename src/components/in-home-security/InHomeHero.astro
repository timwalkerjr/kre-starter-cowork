---
---
<section id="in-home-hero" class="bg-surface py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div class="reveal-left">
        <div class="mb-4">
          <span class="text-xs font-display font-bold uppercase tracking-widest" style="color: var(--color-primary);">
            [ Home & Business Protection ]
          </span>
        </div>
        <h1 class="font-display font-bold uppercase tracking-tight text-foreground mb-6"
            style="font-size: var(--text-h1); line-height: 1.05;">
          In-Home Security<br />Systems
        </h1>
        <p class="text-muted-foreground leading-relaxed mb-6">
          KRE Security LLC. can secure your home or business in the best possible way. We are community oriented and always willing to help you in any situation.
        </p>
        <p class="text-muted-foreground leading-relaxed mb-8">
          We work with a variety of wireless alarm systems with multiple features. All systems are user friendly and easy to install. We can customize the system to your particular needs for your home, business, etc.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact/"
             class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150"
             style="border-color: var(--color-secondary); background-color: var(--color-secondary); color: var(--color-secondary-foreground);">
            Contact Us Today
          </a>
          <a href="/security-checks/"
             class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150"
             style="border-color: var(--color-border); color: var(--color-foreground);">
            Home Security Checks
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="reveal-right">
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_95e787849bb94eb49f4b5e5f7b344a54~mv2-320.webp"
            alt="Home security systems and private security"
            width="320"
            class="w-full max-w-[320px] h-auto object-cover mx-auto"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
