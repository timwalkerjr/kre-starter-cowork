---
---
<section id="logistical-hero" class="bg-dark-background py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div>
        <div class="mb-6">
          <span class="status-dot">[ Logistics Division: Active Since 1990 ]</span>
        </div>
        <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 reveal"
            style="font-size: var(--text-h1); line-height: 1.05;">
          Logistical<br />Business Security
        </h1>
        <p class="text-dark-muted-foreground leading-relaxed text-lg mb-8 reveal reveal-delay-1">
          KRE Security specializes in providing security and logistical services for the transportation industry across the Eastern PA region since 1990, serving the I-78 Lehigh, Berks, and Lebanon Counties corridors.
        </p>
        <a
          href="/contact/"
          class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-8 py-3 transition-colors duration-150 reveal reveal-delay-2"
          style="border-color: var(--color-primary); background-color: var(--color-primary); color: var(--color-primary-foreground);"
        >
          Contact Us Today to Get Started
        </a>
      </div>

      <!-- Image -->
      <div class="reveal-right">
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/20220228_124814-320.webp"
            alt="KRE Security logistical security operations"
            width="320"
            class="w-full max-w-[320px] h-auto object-cover mx-auto"
            loading="eager"
          />
        </div>
        <div class="mt-4 border-l-2 pl-4" style="border-color: var(--color-primary);">
          <p class="text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground">
            Eastern PA | I-78 Corridor | Lehigh · Berks · Lebanon
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
