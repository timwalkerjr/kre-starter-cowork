---
const relatedPosts = [
  {
    href: "/post/wfmz-jewish-community-in-berks-gathers-for-yom-kippur-amid-violence-overseas/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_3e2acdced9ee48b1818600424b0380e9~mv2-289.webp",
    alt: "WFMZ: Jewish community in Berks gathers for Yom Kippur amid violence overseas",
    title: "WFMZ: Jewish Community in Berks Gathers for Yom Kippur Amid Violence Overseas",
  },
  {
    href: "/post/6-kre-school-security-division-just-attended/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_32853a3ba0cc434abd81bdcfe3e6105a~mv2_d_2048_1365_s_2-289.webp",
    alt: "KRE School Security Division",
    title: "KRE School Security Division Just Attended...",
  },
];
---
<section id="post-hero" class="bg-dark-background py-16 lg:py-24">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    <div class="mb-6">
      <a href="/blog/" class="text-xs font-display font-bold uppercase tracking-widest transition-colors"
         style="color: var(--color-primary);">
        &larr; Back to News
      </a>
    </div>
    <div class="mb-4">
      <span class="status-dot">[ Community News ]</span>
    </div>
    <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-8 reveal"
        style="font-size: var(--text-h2); line-height: 1.1;">
      'Firefighting Siblings': Sister Succeeds Brother as Department's New Chief
    </h1>
  </div>
</section>

<section id="post-content" class="bg-background py-12 lg:py-16">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">

    <!-- Hero Image -->
    <div class="tactical-frame overflow-hidden mb-8 reveal">
      <img
        src="https://pagesmith-cdn.com/d22f750a/images/63861c_2f819f062c744b6abdbc5cf4c3d2c77c~mv2-640.webp"
        alt="Firefighting siblings - Hamburg PA fire department"
        width="640"
        class="w-full max-w-[640px] h-auto object-cover"
        loading="eager"
      />
    </div>

    <!-- External Link -->
    <div class="border-2 border-border p-6 mb-8 reveal" style="background-color: var(--color-surface);">
      <p class="text-xs font-display font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary);">
        [ Source Article ]
      </p>
      <a
        href="https://www.wfmz.com/news/area/berks/firefighting-siblings-sister-succeeds-brother-as-departments-new-chief/article_1626dd3e-eb95-4b82-b88e-309a8e09f370.html"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150"
        style="border-color: var(--color-secondary); background-color: var(--color-secondary); color: var(--color-secondary-foreground);"
      >
        View Full Article on WFMZ &rarr;
      </a>
    </div>

    <!-- Excerpt -->
    <div class="prose max-w-none reveal">
      <p class="text-muted-foreground leading-relaxed text-base mb-4">
        HAMBURG, Pa. — After years of fighting fires, Hamburg Fire Chief Jarrod Emes recently decided to no longer focus on fires, but family.
      </p>
      <blockquote class="border-l-4 pl-4 italic text-muted-foreground my-6" style="border-color: var(--color-primary);">
        "I wrapped up a twenty-eight-year career. The tail end of it was just a refocus on family. It's been a long time serving the organization and community," said Emes.
      </blockquote>
    </div>
  </div>
</section>

<!-- Related Posts -->
<section id="post-related" class="py-12 lg:py-16 border-t border-border" style="background-color: var(--color-surface);">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    <div class="mb-6">
      <span class="text-xs font-display font-bold uppercase tracking-widest" style="color: var(--color-primary);">
        [ Related News ]
      </span>
    </div>
    <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-8"
        style="font-size: var(--text-h3); line-height: 1.2;">
      More from KRE Security
    </h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {relatedPosts.map((post) => (
        <a href={post.href} class="group border border-border overflow-hidden block" style="background-color: var(--color-background);">
          <div class="overflow-hidden">
            <img
              src={post.img}
              alt={post.alt}
              width="289"
              class="w-full max-w-[289px] h-auto object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <p class="font-display font-bold uppercase tracking-wide text-foreground text-sm leading-snug group-hover:text-primary transition-colors">
              {post.title}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
