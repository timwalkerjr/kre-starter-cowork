---
const investigations = [
  'Accident Investigation', 'Accident Reconstruction', 'Activity Checks',
  'Adoptions / Biological Parents', 'Aerial Photography', 'Arson Investigation',
  'Assets Investigation', 'Attempt To Locate', 'Audio/Video Forensics',
  'Aviation Issues', 'Background Investigation', 'Banking Community',
  'Blood Stain Analysis', 'Cellular Forensics', 'Cheating Spouse',
  'Child Abuse Investigation', 'Child Custody Investigations', 'Civil Investigation/Litigation Support',
  'Civil Litigation Support', 'Cohabitation/Alimony Investigations', 'Computer Forensics',
  'Computer Forensics Investigations', 'Corporate Investigation', 'Court Record Research',
  'Covert CCTV Installation', 'Criminal Defense Investigations', 'Crisis Management',
  'CTPAT Compliance', 'Custody & Support Issues', 'Database Searches',
  'De-Bugging Services', 'DMV Information', 'Domestic Investigation',
  'Drug Investigation', 'Due Diligence', 'Employment/Pre-Employment Issues',
  'Environmental Issues/Investigation', 'Ethics Issues', 'Expert Witness',
  'Explosives', 'Financial Investigation', 'Fingerprinting',
  'Forensic Accounting', 'Genealogy Research', 'General Investigations',
  'GPS Tracking', 'Homicide/Death Investigation', 'Insurance/Fraud Investigation',
  'International Investigation', 'Interviews/Witness Locates', 'Major Theft',
  'Marine Related Issues', 'Medical Malpractice', 'Missing Persons',
  'Nursing Home Abuse', 'Paranormal Investigation', 'Personal Injury Investigation',
  'Photography', 'Polygraph', 'Post Conviction Relief Act',
  'Process Services', 'Product Counterfeiting', 'Product Diversion',
  'Product Liability', 'Protective Service', 'Real Estate Investigation',
  'Risk Management', 'School Security', 'Security Consulting/Training',
  'Security Officer Deployment', 'Security Surveys', 'Sex Crimes',
  'Statement Analysis', 'Surveillance Investigations', 'Technical Countermeasures',
  'Undercover Operations', 'White Collar Crime', 'Workers Compensation Investigation',
];
---
<section class="bg-background" id="pi-services">
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="max-w-2xl mb-12">
      <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3">[ Investigation Types ]</p>
      <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-4">
        Providing Private Investigation Services For The Following:
      </h2>
      <p class="font-sans text-muted-foreground leading-relaxed">
        Our comprehensive investigation capabilities span local and national cases, tailored to each client's specific needs.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 mb-16">
      {investigations.map((item) => (
        <div class="flex items-center gap-2 p-3 border border-border bg-surface hover:border-primary hover:bg-background transition-colors duration-150 group">
          <span class="w-1.5 h-1.5 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]"></span>
          <span class="font-sans text-xs text-foreground">{item}</span>
        </div>
      ))}
    </div>

    <!-- Gallery Row 2 -->
    <div class="grid grid-cols-3 md:grid-cols-5 lg:grid-cols-10 gap-2 mb-12">
      {[
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_a272516e4fa8439bbe716d944eb3148f~mv2-249.webp', alt: 'Private investigator Bucks County' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_e230718b9ea643a2afff68600a7065bc~mv2-249.webp', alt: 'Domestic violence private investigator Lehigh' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_40dd4740abfa44788b33dd10823d839c~mv2-249.webp', alt: 'Private investigator for cheating spouse Berks' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_0ca781b46edd4907a9d6131400942c17~mv2-249.webp', alt: 'Financial private investigators' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_3cd3d8abc8494c5aa9c9bffb7cc11482~mv2-249.webp', alt: 'Fingerprinting and private investigators' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_6e1e4fcc3dd940518701cf28ecf5d704~mv2-249.webp', alt: 'Homicide private investigators' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_5dfd99ec32d24f7eaac23656994d7dfb~mv2-249.webp', alt: 'Major theft private investigators' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_4de679ce448340d3959138760475687a~mv2-249.webp', alt: 'School private investigators' },
        { src: 'https://pagesmith-cdn.com/d22f750a/images/39725c_e0319929c0654d17a6db72fdb9808be7~mv2-249.webp', alt: 'Surveillance private investigators' },
      ].map((img) => (
        <div class="aspect-square overflow-hidden border border-border">
          <img src={img.src} alt={img.alt} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="bg-dark-background p-8 flex flex-col md:flex-row items-center justify-between gap-6 relative">
      <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px"></div>
      <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px"></div>
      <div>
        <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-1">[ KRE Investigations Division ]</p>
        <p class="font-sans text-dark-foreground text-lg">Ready to discuss your case? Contact us today.</p>
      </div>
      <a
        href="/#contact"
        class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover whitespace-nowrap transition-colors duration-150"
      >
        Contact Us to Get Started
      </a>
    </div>
  </div>
</section>
