---
const services = [
  'School Event Services',
  'Fair Grounds Employees',
  'Party Event Staffing',
  'Stadium Staff',
  'Concert Employees',
  'School & Venue Based Sporting Game Ushers',
  'Convention Staffing and Security',
  'Sports Events Staffing and Security',
  'Trade Show Event Staffing and Security',
  'And Much More',
];

const capabilities = [
  { label: 'Crowd Management', icon: '●' },
  { label: 'Access Control', icon: '●' },
  { label: 'VIP Security', icon: '●' },
  { label: 'Guest Services', icon: '●' },
  { label: 'Personal Protection', icon: '●' },
  { label: 'Parking Lot Attendants', icon: '●' },
  { label: 'Traffic Control Services', icon: '●' },
  { label: 'Event Ushers', icon: '●' },
];
---
<section class="bg-surface" id="event-staff-services">
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Services List -->
      <div>
        <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3">[ Event Staffing Division ]</p>
        <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-6">
          Our Event Staffing Company Can Provide:
        </h2>
        <p class="font-sans text-foreground leading-relaxed mb-8">
          We provide the staffing for large and small events. If there will be a large gathering of people, we can make sure there are enough bodies to manage and control the flow of traffic, ensure safety, provide assistance, or manage the crowds.
        </p>

        <div class="space-y-2 mb-10">
          {services.map((service, i) => (
            <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group reveal" style={`transition-delay: ${i * 50}ms`}>
              <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]"></span>
              <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide">{service}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Capabilities + Image -->
      <div class="space-y-6">
        <div class="bg-dark-background p-8 relative">
          <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px"></div>
          <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px"></div>
          <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-4">[ Staff Capabilities ]</p>
          <div class="grid grid-cols-2 gap-3">
            {capabilities.map((cap) => (
              <div class="flex items-center gap-2">
                <span class="text-primary text-xs">{cap.icon}</span>
                <span class="font-sans text-xs text-dark-muted-foreground">{cap.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_3ba4109b5877408ba9c2e259be148c43~mv2-768.webp"
            alt="Event staff security eastern PA"
            class="w-full max-w-[768px] h-auto object-cover"
            loading="lazy"
          />
        </div>

        <a
          href="/#contact"
          class="inline-block w-full text-center bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
        >
          Contact Us to Get Started
        </a>
      </div>
    </div>
  </div>
</section>
