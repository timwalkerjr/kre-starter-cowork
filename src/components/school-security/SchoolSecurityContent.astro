---
const services = [
  'Special Events Security',
  'Sporting Event Security',
  'Proms & School Events',
  'Traffic Direction',
  'Building Patrols',
  'Event Security Services',
  'Security Consulting for Districts',
];
---
<section class="bg-surface" id="school-security-services">
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Services -->
      <div>
        <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3">[ Services Provided ]</p>
        <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-6">
          Comprehensive School Security Solutions
        </h2>
        <p class="font-sans text-foreground leading-relaxed mb-6">
          Our school security officers are well diverse to perform services within the education setting, with our goal to promote the safety and well being while maintaining the academic setting for students, staff, and guests to the school districts and university campuses we provide services to.
        </p>

        <div class="space-y-2 mb-10">
          {services.map((service, i) => (
            <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group reveal" style={`transition-delay: ${i * 60}ms`}>
              <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]"></span>
              <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide">{service}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Armed Security + Guards -->
      <div class="space-y-6">
        <!-- Armed Security Card -->
        <div class="bg-dark-background p-8 relative">
          <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px"></div>
          <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px"></div>
          <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-3">[ Armed School Security ]</p>
          <p class="font-sans text-dark-muted-foreground leading-relaxed mb-4">
            KRE Security currently provides armed agents to service as a protection role in several districts across the region. Our professional armed security guard staff has prior backgrounds in law enforcement, public safety, and educational backgrounds, which allows for our agents to interact with students to gain the professional trust of a security presence daily in the schools.
          </p>
          <a
            href="/armed-security-pa/"
            class="inline-block bg-primary text-primary-foreground font-display font-bold text-xs uppercase tracking-widest px-6 py-3 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Armed Security Services →
          </a>
        </div>

        <!-- Guard Image -->
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_797b9b116d42412dbbebab45c6dee4e0~mv2-320.webp"
            alt="School security guards"
            class="w-full max-w-[320px] h-auto object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ACT 67 / NASRO Training Section -->
<section class="bg-background" id="school-security-training">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="tactical-frame overflow-hidden">
        <img
          src="https://pagesmith-cdn.com/d22f750a/images/KRE-NASRO-Class-Photo--320.webp"
          alt="KRE NASRO Class Photo — ACT 67 Training"
          class="w-full h-auto object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3">[ ACT 67 Training ]</p>
        <h2 class="font-display font-bold text-h3 text-foreground uppercase tracking-tight leading-tight mb-4">
          NASRO Certified & ACT 67 Compliant
        </h2>
        <p class="font-sans text-foreground leading-relaxed mb-6">
          Six, including management, members of the KRE school Security Division just attended training at the BCIU Berks County Intermediate Unit — Reading, PA as part of the PA ACT 67 training for deployment as Armed Security in several districts KRE provides services to.
        </p>
        <p class="font-sans text-muted-foreground leading-relaxed mb-8">
          Photos Courtesy of Harold Hoch of the Reading Eagle.
        </p>
        <a
          href="/act-67-certified-services/"
          class="inline-block bg-foreground text-background font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-foreground hover:bg-primary hover:text-foreground hover:border-primary transition-colors duration-150"
        >
          ACT 67 Certified Services
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Wide Guard Image + CTA -->
<section class="bg-surface">
  <div class="max-w-7xl mx-auto px-6 pb-16">
    <div class="tactical-frame overflow-hidden mb-8">
      <img
        src="https://pagesmith-cdn.com/d22f750a/images/39725c_3ba4109b5877408ba9c2e259be148c43~mv2-768.webp"
        alt="School security guard services"
        class="w-full max-w-[768px] h-auto object-cover mx-auto"
        loading="lazy"
      />
    </div>
    <div class="bg-dark-background p-8 flex flex-col md:flex-row items-center justify-between gap-6 relative">
      <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px"></div>
      <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px"></div>
      <div>
        <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-1">[ KRE Security LLC. ]</p>
        <p class="font-sans text-dark-foreground text-lg">Ready to secure your school district? Contact us today.</p>
      </div>
      <a
        href="/#contact"
        class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover whitespace-nowrap transition-colors duration-150"
      >
        Contact Us to Get Started
      </a>
    </div>
  </div>
</section>
