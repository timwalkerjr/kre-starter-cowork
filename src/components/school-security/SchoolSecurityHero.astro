---
---
<section class="bg-dark-background" id="school-security-hero">
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="status-dot mb-6 block">[ Dispatch Status: Active ]</span>
        <h1 class="font-display font-bold text-h1 text-dark-foreground uppercase tracking-tight leading-tight mb-6">
          School Security Guard Services
        </h1>
        <p class="font-sans text-dark-muted-foreground text-lg leading-relaxed mb-4">
          KRE Security LLC. is a local, well trusted and respected security company who has been providing a vast portion of security and protection needs to school districts across the region.
        </p>
        <p class="font-sans text-dark-muted-foreground leading-relaxed mb-8">
          Our high standard of performance and professionalism has allowed our firm to provide ongoing services for over 25 years throughout Berks, Schuylkill, Lehigh, &amp; Montgomery Counties.
        </p>

        <!-- NASRO Badge -->
        <div class="bg-dark-border/30 border border-dark-border p-4 mb-8 relative inline-flex items-center gap-4">
          <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px"></div>
          <div class="w-2 h-2 bg-primary rounded-full animate-pulse"></div>
          <div>
            <p class="font-display text-xs font-bold uppercase tracking-widest text-primary">[ Certified ]</p>
            <p class="font-sans text-sm text-dark-foreground font-bold">Our Full-Time Staff are all certified by the NASRO</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="/#contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Contact Us to Get Started
          </a>
          <a
            href="/armed-security-pa/"
            class="inline-block bg-transparent text-dark-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
          >
            Armed Security Info
          </a>
        </div>
      </div>

      <!-- Images -->
      <div class="grid grid-cols-2 gap-3">
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/pastedImage-249.webp"
            alt="School security services"
            class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/IMG_2754-320.webp"
            alt="KRE school security officer"
            class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
        <div class="tactical-frame overflow-hidden col-span-2">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_5cd7e3e1e5d84cc6a46b497a37fc813c~mv2-320.webp"
            alt="School safety services"
            class="w-full h-40 object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
