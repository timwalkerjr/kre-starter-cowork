---
const checkItems = [
  "Check all doors and windows to be sure closed and locked",
  "Water indoor and outdoor plants per your instructions",
  "Bring in mail, solicitation flyers & newspapers",
  "Rotate lights for lived-in look",
  "Check for water leaks under sinks, toilets and washing machine",
  "After rain storm check ceilings in home and garage for water leaks",
  "Follow up with landscaper, pool server, housekeeper, pest control, etc., as needed",
  "Spray weeds (client provides weed spray)",
  "Put out trash cans on scheduled trash, then put away after emptied",
  "Prepare home for client's return — reset thermostat, turn some lights on, schedule housekeeper, pest control, etc.",
  "After each inspection, we will notify you of our findings",
  "Alarm response by officers to check on your property while you are away",
];
---
<section class="bg-surface py-20" data-ps="security-checks/SecurityChecksContent.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-14 reveal">
      <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
        [ Comprehensive Inspection ]
      </p>
      <h2
        class="font-display font-bold uppercase tracking-tight text-foreground"
        style="font-size: var(--text-h2); line-height: 1.1;"
      >
        What Do Home Security Checks Include?
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mb-16">
      {checkItems.map((item, i) => (
        <div class={`flex gap-4 items-start tactical-frame bg-background p-4 reveal reveal-delay-${Math.min((i % 4) + 1, 5)}`}>
          <span class="mt-1 w-2 h-2 bg-primary flex-shrink-0"></span>
          <span class="text-muted-foreground text-sm leading-relaxed">{item}</span>
        </div>
      ))}
    </div>

    <!-- Coverage + CTA dark panel -->
    <div class="bg-dark-background p-8 lg:p-12 tactical-frame reveal">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
            [ Coverage Area ]
          </p>
          <h2
            class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-4"
            style="font-size: var(--text-h2); line-height: 1.1;"
          >
            Serving Eastern Pennsylvania
          </h2>
          <p class="text-dark-muted-foreground text-sm leading-relaxed mb-6">
            KRE Security LLC. offers Berks, Schuylkill, Lehigh and surrounding counties expert home security check services — giving you, the home or business owner, complete peace-of-mind while you are away.
          </p>
          <div class="flex flex-wrap gap-2 mb-8">
            {["Berks County", "Schuylkill County", "Lehigh County", "Surrounding Counties"].map(county => (
              <span class="border border-dark-border text-dark-muted-foreground font-display font-bold uppercase text-xs tracking-widest px-3 py-1">
                {county}
              </span>
            ))}
          </div>
          <a
            href="/contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Contact Us Today to Get Started
          </a>
        </div>
        <div class="space-y-4">
          <div class="border border-dark-border p-5">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">[ Peace of Mind ]</p>
            <p class="text-dark-muted-foreground text-sm leading-relaxed">
              Our security checks are designed and planned with you in mind — giving you total confidence while you're on vacation, traveling for business, or out of town for a prolonged period.
            </p>
          </div>
          <div class="border border-dark-border p-5">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">[ Personal Care ]</p>
            <p class="text-dark-muted-foreground text-sm leading-relaxed">
              We care for your home as if it were our very own. Every inspection is followed up with a full report of our findings.
            </p>
          </div>
          <div class="border border-dark-border p-5">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">[ 24-Hour Alarm Response ]</p>
            <p class="text-dark-muted-foreground text-sm leading-relaxed">
              Our officers respond to alarms and check on your property around the clock while you are away.
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
