---
---
<section class="bg-dark-background py-20" data-ps="security-checks/SecurityChecksHero.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="status-dot">[ Berks · Schuylkill · Lehigh & Surrounding Counties ]</span>
    </div>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1
          class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6"
          style="font-size: var(--text-h1); line-height: 1.05;"
        >
          Residential / Commercial Security Checks
        </h1>
        <p class="text-primary font-display font-bold uppercase tracking-widest text-sm mb-4">
          "Your Total Security Professional"
        </p>
        <p class="text-dark-muted-foreground text-base leading-relaxed mb-8 max-w-lg">
          KRE Security LLC. offers expert home security check services — giving you, the home or business owner, peace-of-mind while you are on vacation, traveling for business or out of town for a prolonged period of time. We care for your home as if it were our very own.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Contact Us Today
          </a>
          <a
            href="tel:16105620971"
            class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
          >
            610-562-0971
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_91ebaf25dff34dd39410d0f4f785fe77~mv2-320.webp"
            alt="Out of town home security check services"
            class="w-full max-w-[320px] h-48 object-cover"
            loading="eager"
          />
        </div>
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_c009777e5f86444db4532247de687268~mv2-320.webp"
            alt="Put your mind at ease with our home security checks"
            class="w-full max-w-[320px] h-48 object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
