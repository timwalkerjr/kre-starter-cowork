<section class="bg-dark-background py-20" data-ps="security-company-faq/FaqHero.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="status-dot">[ PA State License No. 84 ]</span>
    </div>
    <h1
      class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-4 max-w-3xl"
      style="font-size: var(--text-h1); line-height: 1.05;"
    >
      Frequently Asked Questions
    </h1>
    <p class="text-dark-muted-foreground text-base leading-relaxed max-w-2xl mb-8">
      For more information about KRE Security LLC. and our services, review the answers below or fill out the contact form and we'll get back to you as soon as we can.
    </p>
    <a
      href="#faq-contact"
      class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
    >
      Ask a Question
    </a>
  </div>
</section>
