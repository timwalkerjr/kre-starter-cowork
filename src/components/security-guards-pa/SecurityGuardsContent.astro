---
const benefits = [
  {
    num: "01",
    title: "Focus on What You Do Best",
    desc: "When you leave the security function up to someone else, you and your company can concentrate your resources on the business. Having a security guard company control the security duties, you can get back to taking care of your customers."
  },
  {
    num: "02",
    title: "Leave It to the Experts",
    desc: "By contracting our security guard service, you can rest assured that we have invested copious amounts of time training our staff, researching the best equipment to use, and making sure all of our (and your) bases are covered."
  },
  {
    num: "03",
    title: "Free Up Your Resources",
    desc: "Outsourcing the security function of your company will allow you to free up your personnel that are serving this duty to perform other, potentially more important, actions. Keep your focus on efficiency of your process, customer service and the final product."
  },
  {
    num: "04",
    title: "Reduce Risk",
    desc: "Once a contract is signed, we are accountable for the security of your company and/or the details outlined in the contract. Breathe a sigh of relief when that worry is off your plate and know you are in good hands."
  },
];

const serviceTypes = [
  "Agriculture", "Apartment Complexes", "Armed/Unarmed Security Guards", "Asset Protection",
  "Bar/Nightclub Security", "College/Universities", "Commercial Real Estate", "Construction Security",
  "Distribution Facilities", "Energy & Utilities", "Emergency Storm Response Security", "Facility Security",
  "Film Production Site Security", "Fire Watch Security Services", "Government Services",
  "Healthcare Facilities", "Industrial Park Security (24/7)", "Large Event Security",
  "Long Term Contracts", "Malls", "Manufacturing & Industrial", "Mobile Security Patrol",
  "National Security Contracts", "Night Watchmen", "Office Buildings", "On-site Security",
  "Personal Protection", "Private Parking Enforcement", "Residential Communities",
  "Restaurant Maintenance", "Retail Security", "School Events", "Shopping Centers",
  "Special Event Parking Security", "Temporary and Long-term Security", "Uniformed Patrol Services",
  "Warehouse Security (24/7)"
];

const galleryImages = [
  { src: "https://pagesmith-cdn.com/d22f750a/images/39725c_57d30354f75c459a8ff7493a8ed2e778~mv2-239.webp", alt: "Security companies in PA", maxW: "239" },
  { src: "https://pagesmith-cdn.com/d22f750a/images/39725c_6af31e81bf8740d4b966aa8251765f40~mv2-225.webp", alt: "Security guard companies in Reading", maxW: "225" },
  { src: "https://pagesmith-cdn.com/d22f750a/images/39725c_0e10faf1585c4f2c8fbd4262dc8e6a54~mv2-225.webp", alt: "Armed & unarmed security services Philadelphia PA", maxW: "225" },
  { src: "https://pagesmith-cdn.com/d22f750a/images/39725c_41f7dc4afc7d4747817dba023b4d5ddd~mv2-225.webp", alt: "Best private investigator eastern PA", maxW: "225" },
  { src: "https://pagesmith-cdn.com/d22f750a/images/39725c_cdcbaf3497194856a579bc8bfbcfe3c2~mv2-225.webp", alt: "Armed security guard Lehigh Valley", maxW: "225" },
];
---
<section class="bg-surface py-20" data-ps="security-guards-pa/SecurityGuardsContent.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <!-- Benefits of Outsourcing -->
    <div class="mb-20">
      <div class="text-center mb-12 reveal">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Why Outsource? ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Benefits of Outsourcing Security Guard Services
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {benefits.map((b, i) => (
          <div class={`tactical-frame bg-background p-6 reveal reveal-delay-${i + 1}`}>
            <span class="text-primary font-display font-bold text-3xl block mb-3">{b.num}</span>
            <h3 class="font-display font-bold uppercase text-foreground text-base mb-3">{b.title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Guard Pro System dark panel -->
    <div class="bg-dark-background p-8 lg:p-12 tactical-frame mb-20 reveal">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
            [ KRE Accountability Technology ]
          </p>
          <h2
            class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-4"
            style="font-size: var(--text-h2); line-height: 1.1;"
          >
            The Guard Pro System
          </h2>
          <p class="text-dark-muted-foreground text-sm leading-relaxed mb-4">
            The Guard Pro System insures quality control and accountability of the guards and the client that their needs are being met by our security guard professionals.
          </p>
          <p class="text-dark-muted-foreground text-sm leading-relaxed mb-4">
            Guard Pro systems allow our managers to meet with both the client and the security guard to ensure proper rounds are conducted at each shift. KRE managers will provide written reports to the client in order to provide better manager-client relations.
          </p>
          <p class="text-dark-muted-foreground text-sm leading-relaxed">
            This is part of KRE Security's customer service satisfaction guarantee. We are willing to meet any needs that the client may have while knowing their property is protected.
          </p>
        </div>
        <div class="space-y-4">
          <p class="text-dark-muted-foreground text-sm leading-relaxed border-l-2 border-primary pl-4">
            Our security guard service staff maintains a professional demeanor at all times. Our officers hold current emergency services training, such as CPR and First Aid.
          </p>
          <p class="text-dark-muted-foreground text-sm leading-relaxed border-l-2 border-primary pl-4">
            KRE Security officers have an ongoing relationship with local level police, fire and EMS agencies throughout the area.
          </p>
          <p class="text-dark-muted-foreground text-sm leading-relaxed border-l-2 border-primary pl-4">
            KRE Security employs top quality security professionals who have extensive experience working in the criminal and public safety fields.
          </p>
        </div>
      </div>
    </div>

    <!-- Services provided grid -->
    <div class="mb-20">
      <div class="text-center mb-12 reveal">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Full Spectrum Coverage ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Providing Security Guard Services for:
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 reveal">
        {serviceTypes.map(type => (
          <div class="flex items-center gap-2 border border-border bg-background p-2.5">
            <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>
            <span class="text-muted-foreground text-xs leading-tight">{type}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Photo gallery -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-16 reveal">
      {galleryImages.map(img => (
        <div class="tactical-frame overflow-hidden">
          <img
            src={img.src}
            alt={img.alt}
            class={`w-full max-w-[${img.maxW}px] h-32 object-cover`}
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <a
        href="/contact"
        class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-10 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
      >
        Contact Us Today to Get Started
      </a>
    </div>

  </div>
</section>
