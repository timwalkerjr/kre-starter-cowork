---
---
<section class="bg-dark-background py-20" data-ps="security-guards-pa/SecurityGuardsHero.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="status-dot">[ Guard Pro Accountability System Active ]</span>
    </div>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1
          class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6"
          style="font-size: var(--text-h1); line-height: 1.05;"
        >
          Security Guard Services Eastern Pennsylvania
        </h1>
        <p class="text-dark-muted-foreground text-base leading-relaxed mb-4 max-w-lg">
          KRE Security LLC. provides a variety of both public and private event, unarmed or armed security guard services across Pennsylvania. We provide short term, long term, and permanent security guard services to our clients 24/7.
        </p>
        <p class="text-dark-muted-foreground text-sm leading-relaxed mb-8 max-w-lg">
          Our security officers provide a public security presence which allows our customers the peace of mind knowing that their property is protected at all hours.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Contact Us Today
          </a>
          <a
            href="/armed-security-pa"
            class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
          >
            Armed Security
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/39725c_ae664ab23abd45948c48b214d6897bcb~mv2-262.webp"
            alt="Private armed security companies in PA"
            class="w-full max-w-[262px] h-48 object-cover"
            loading="eager"
          />
        </div>
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/Attachment-301.webp"
            alt="KRE Security guard services"
            class="w-full max-w-[301px] h-48 object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
