---
const teamMembers = [
  {
    name: "Kandice Pyles",
    title: "Executive Director of Finance",
    image: "https://pagesmith-cdn.com/d22f750a/images/63861c_1140176b21f944f687d5a4673411f71b~mv2-230.webp",
    imageAlt: "Kandice Pyles finance & scheduling mgr",
    maxW: "230",
    bio: "Miss Pyles holds a Bachelor's degree in Sports Administration with a Minor in Business Administration from Indiana University of Pennsylvania. She is primarily responsible for overseeing and managing the financial, payroll, and billing departments at KRE Security. Kandice's expertise has been instrumental in implementing an updated employee tracking, scheduling, and payroll management system within our office. Her focus on financial stability and integrity is central to the services KRE provides.",
  },
  {
    name: "Matthew Peters",
    title: "Executive Director / Client & Staff Relations / Operations",
    image: "https://pagesmith-cdn.com/d22f750a/images/profile-picture-237.webp",
    imageAlt: "Matthew Peters - Executive Director",
    maxW: "237",
    bio: "Matt brings a very diverse skill set to the company. With a Communications degree from Penn State University, Matt also completed the prestigious Marsh and McLennan Management & Leadership Training Course in Dallas, TX. A United States Marine Corps veteran, Matt served multiple combat tours in Iraq and held a Secret Clearance during his time in service. He has a wealth of experience in security management, having worked as a supervisor at Southern California nightclubs, professional sporting events, and live music venues.",
  },
  {
    name: "Rachael Dalton",
    title: "Senior Director of Administration",
    image: "https://pagesmith-cdn.com/d22f750a/images/1000017319-237.webp",
    imageAlt: "Rachael Dalton - Senior Director of Administration",
    maxW: "237",
    bio: "Ms. Dalton joined KRE Security in August 2021, initially serving as a Dispatcher before quickly advancing through roles to her current position. With over 25 years of experience in Administration, Human Resources, and Scheduling, Rachael brings a wealth of expertise to her role. She holds her Act 235 Lethal Weapons Certification through the Commonwealth of Pennsylvania. As Director of Administration, Rachael is responsible for providing direct support to KRE President Jarrod Emes and overseeing day-to-day operations.",
  },
  {
    name: "Amanda Ahmed, M.A.",
    title: "Hiring Recruitment Supervisor",
    image: "https://pagesmith-cdn.com/d22f750a/images/image-237.webp",
    imageAlt: "Amanda Ahmed - Hiring Recruitment Supervisor",
    maxW: "237",
    bio: "Amanda Ahmed is KRE Security's Hiring and Recruitment Supervisor, bringing an exceptional blend of professionalism, insight, and heart to her work. Armed with a Master's degree in Forensic Psychology from Kean University, where she graduated with a perfect 4.0 GPA, Amanda combines sharp analytical thinking with a genuine passion for people and organizational excellence. She plays a vital role in building and strengthening KRE's team of talented and dependable professionals.",
  },
  {
    name: "Jeff Weidenhammer",
    title: "Fleet Supervisor",
    image: "https://pagesmith-cdn.com/d22f750a/images/Screenshot_20260331_104832_Messages-227.webp",
    imageAlt: "Jeff Weidenhammer - Fleet Supervisor",
    maxW: "227",
    bio: "Jeff joined KRE Security in 2015 and quickly grew into a trusted leader, serving in roles ranging from Security Officer to Site Lead, Manager, Supervisor, and Operations Manager. Over nearly 16 years of service, Jeff has worn many hats across the organization. Today, Jeff plays a key role in supporting KRE's continued growth by overseeing the company's fleet of vehicles, including cars, trucks, trailers, and golf carts.",
  },
  {
    name: "Samantha Chase",
    title: "Contract & Risk Administration Manager",
    image: "https://pagesmith-cdn.com/d22f750a/images/image-227.webp",
    imageAlt: "Samantha Chase - Contract & Risk Administration Manager",
    maxW: "227",
    bio: "Samantha joined KRE Security in May 2024 as a Scheduling Coordinator and quickly advanced to Director of Scheduling, then to her current role as Contract and Risk Administration Manager. She brings more than 15 years of experience in customer service, transportation, logistics, client services, and scheduling within fast-paced, security-focused environments.",
  },
  {
    name: "Joseph Dzingleski",
    title: "Operations Manager",
    image: "https://pagesmith-cdn.com/d22f750a/images/image-227.webp",
    imageAlt: "Joseph Dzingleski - Operations Manager",
    maxW: "227",
    bio: "Joseph Dzingleski is the Operations Manager at KRE Security, overseeing day-to-day security operations across a wide range of client environments including corporate, retail, industrial, and educational sites. He previously served in the United States Army as an Infantry Team Leader and Squad Leader, and serves as a volunteer firefighter. Joseph holds a Bachelor of Science in Emergency Management and Homeland Security.",
  },
  {
    name: "James P. Wilson",
    title: "Senior Field Supervisor",
    image: "https://pagesmith-cdn.com/d22f750a/images/jim-237.webp",
    imageAlt: "James P. Wilson - Senior Field Supervisor",
    maxW: "237",
    bio: "Jim is a seasoned professional with over 30 years of experience in law enforcement, corrections, and management. A retired Act 120 Certified Patrolman from the Wyomissing Police Department. At KRE Security, Jim oversees the Firearms Training Program, field operations, training, and investigations division. He ensures that daily field operations comply with client needs and manages safety plans and training.",
  },
];
---
<section class="bg-surface py-20" data-ps="security-services-pa/SecurityServicesTeam.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-14 reveal">
      <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
        [ Leadership & Operations ]
      </p>
      <h2
        class="font-display font-bold uppercase tracking-tight text-foreground"
        style="font-size: var(--text-h2); line-height: 1.1;"
      >
        KRE Security Management Team
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-20">
      {teamMembers.map((member, i) => (
        <div class={`tactical-frame bg-background flex gap-5 p-6 reveal reveal-delay-${Math.min((i % 4) + 1, 5)}`}>
          <div class="flex-shrink-0">
            <img
              src={member.image}
              alt={member.imageAlt}
              class={`max-w-[80px] w-full h-24 object-cover object-top`}
              loading="lazy"
            />
          </div>
          <div>
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-1">
              {member.title}
            </p>
            <h3 class="font-display font-bold uppercase text-foreground text-base mb-3">
              {member.name}
            </h3>
            <p class="text-muted-foreground text-xs leading-relaxed">
              {member.bio}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
