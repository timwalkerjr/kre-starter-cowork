---
const testimonials = [
  {
    quote: "I have worked with KRE Security for over 15 years, as our facilities primary full time Security team. They helped us with securing over 200 hours per week of security guard services. Jarrod and Jim's team go above and beyond to meet our needs. We have used larger scale firms in past but KRE has been far been the best fit for our facility. I recommend any and all large scale projects to go with the KRE team here in Berks County.",
    author: "John Lubas",
    title: "Faculty Director, Community Out Reach",
  },
  {
    quote: "KRE Security/Investigations Inc. was contracted for a full-time, unarmed security guard for about a month during school hours, in 2015, after a heroin overdose took place on campus. KRE provides security to the district for sporting events. Jarrod/KRE Security Staff and the state police have been phenomenal.",
    author: "Andrew M. Potteiger",
    title: "School Administrator",
  },
  {
    quote: "KRE is a terrific business partner and supplier of security services to my company. Their employees are very professional and their rates are very competitive. I highly recommend KRE to anyone looking to improve their security services.",
    author: "Anonymous",
    title: "Manufacturing Facility Manager, Carbon County, PA",
  },
  {
    quote: "I am very satisfied with KRE Security Investigations, Inc. I called on a Wednesday about a project I was hoping the company could help with involving pictures of a residence. Jarrod was polite, and eager to assist in whatever way necessary. He was able to take 28 photographs for me within 2 days of my request, and captured all the details that I had asked for. The photos were delivered promptly, and there was great follow-up from Jarrod afterwards. Overall I am pleased with the work that was done, and how easy it was to communicate with the company via phone and email. The price was reasonable, and so I would recommend KRE to anyone needing investigative work done.",
    author: "Lisa McLean",
    title: "Client, New Jersey",
  },
];
---

<section class="bg-background py-20">
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {testimonials.map((t, i) => (
        <div
          class="tactical-frame bg-surface p-8 flex flex-col reveal"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <!-- Quote mark -->
          <div class="text-primary font-display text-5xl font-bold leading-none mb-4 select-none" aria-hidden="true">"</div>

          <blockquote class="font-sans text-foreground text-sm leading-relaxed flex-1 mb-6">
            {t.quote}
          </blockquote>

          <footer class="border-t border-border pt-4">
            <p class="font-display font-bold text-foreground text-sm uppercase tracking-wide">
              — {t.author}
            </p>
            <p class="font-sans text-muted-foreground text-xs mt-1">
              {t.title}
            </p>
          </footer>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center border border-border bg-surface p-10 reveal">
      <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-3">
        [ Share Your Experience ]
      </p>
      <h2 class="font-display font-bold uppercase text-foreground text-h3 mb-4">
        Let Us Know Your Experience with KRE Security
      </h2>
      <p class="font-sans text-muted-foreground text-sm mb-6">
        Your feedback helps us continue to improve our services.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.facebook.com/KREsecinvestigations/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-foreground text-background font-display font-bold uppercase tracking-widest text-xs px-6 py-3 border-2 border-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors"
        >
          Review on Facebook
        </a>
        <a
          href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.986583,17z"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-transparent text-foreground font-display font-bold uppercase tracking-widest text-xs px-6 py-3 border-2 border-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors"
        >
          Review on Google
        </a>
      </div>
    </div>

  </div>
</section>
