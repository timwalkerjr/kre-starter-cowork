---
const equipment = [
  "Flashlight",
  "Spot Lights",
  "Guard Accountability Wand",
  "Incident and Daily Reports",
  "Medical Response Bag",
  "Jumper Cables",
  "KRE and Client Vehicle Policy",
  "Vehicle Log",
  "Traffic Safety Cones",
  "AAA Membership",
  "Traffic Hand Wand",
  "UHF or VHF Radio (Programmable to client sites)",
];

const fleetOptions = [
  {
    tag: "Marked Fleet",
    title: "Marked Patrol Vehicles",
    desc: "High-visibility branded patrol vehicles providing a deterrent presence and active patrol of client facilities. Fully insured and licensed for facility grounds."
  },
  {
    tag: "Covert Fleet",
    title: "Unmarked / Covert Vehicles",
    desc: "Discreet, unmarked patrol vehicles for covert surveillance and undercover security operations — indistinguishable from standard civilian vehicles."
  },
  {
    tag: "All-Terrain",
    title: "4x4 & All-Wheel Drive",
    desc: "4x4 and all-wheel drive capable vehicles can be stationed for the client's specific environmental needs, including off-road and challenging terrain environments."
  },
  {
    tag: "Venue Specific",
    title: "Security Patrol Golf Carts",
    desc: "Golf carts can be utilized on venue-specific areas, offering a cost savings for the facility. Available during warmer conditions and marked for visibility. Can reduce fuel expenses at facilities."
  },
];
---
<section class="bg-surface py-20" data-ps="vehicle-patrol/VehiclePatrolContent.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <!-- About the division -->
    <div class="mb-20 reveal">
      <div class="bg-dark-background p-8 lg:p-12 tactical-frame">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Marked Security Patrol Vehicles Division ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-4"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          KRE Security Vehicle Patrol Division
        </h2>
        <p class="text-dark-muted-foreground text-sm leading-relaxed max-w-3xl">
          KRE provides a custom patrol service based on the client's needs and venue. Our fleet is fully insured and licensed for vehicle use at facility grounds. Each vehicle is configured and equipped to meet the operational demands of the client's site.
        </p>
      </div>
    </div>

    <!-- Fleet options -->
    <div class="mb-20">
      <div class="text-center mb-12 reveal">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Fleet Options ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Vehicle Fleet Overview
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {fleetOptions.map((option, i) => (
          <div class={`tactical-frame bg-background p-6 reveal reveal-delay-${i + 1}`}>
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">
              [ {option.tag} ]
            </p>
            <h3 class="font-display font-bold uppercase text-foreground text-base mb-3">
              {option.title}
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              {option.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Equipment list -->
    <div class="grid lg:grid-cols-2 gap-16 items-start mb-20">
      <div class="reveal">
        <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3">
          [ Standard Loadout ]
        </p>
        <h2
          class="font-display font-bold uppercase tracking-tight text-foreground mb-6"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Each Vehicle is Equipped With:
        </h2>
        <div class="grid grid-cols-2 gap-3">
          {equipment.map(item => (
            <div class="flex items-start gap-3 tactical-frame bg-background p-3">
              <span class="mt-1 w-2 h-2 bg-primary flex-shrink-0"></span>
              <span class="text-muted-foreground text-xs leading-tight">{item}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal-right space-y-4">
        <div class="border border-border bg-background p-5">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">[ Custom Configuration ]</p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            KRE provides a custom patrol service based on the client's needs and venue. Each assignment is assessed and the appropriate vehicle type is assigned.
          </p>
        </div>
        <div class="border border-border bg-background p-5">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">[ UHF / VHF Radio ]</p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            All patrol vehicles are equipped with UHF or VHF radios programmable to the client's specific site frequencies for seamless communication.
          </p>
        </div>
        <div class="border border-border bg-background p-5">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2">[ Golf Cart Option ]</p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Golf Carts can be discussed to reduce fuel expenses at facilities. Available and marked during warmer conditions for venue-specific areas.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <a
        href="/contact"
        class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-10 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
      >
        Contact Us Today to Get Started
      </a>
    </div>

  </div>
</section>
