---
---
<section class="bg-dark-background py-20" data-ps="vehicle-patrol/VehiclePatrolHero.astro">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="status-dot">[ Marked & Unmarked Fleet — Fully Insured & Licensed ]</span>
    </div>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1
          class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6"
          style="font-size: var(--text-h1); line-height: 1.05;"
        >
          Security Vehicle Patrol
        </h1>
        <p class="text-dark-muted-foreground text-base leading-relaxed mb-8 max-w-lg">
          KRE Security has a fleet of Marked Security Patrol Vehicles, Unmarked Patrol, Covert Vehicles, and Security Patrol Golf Carts for venue specific areas. KRE provides a custom patrol service based on the client's needs and venue.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Request a Quote
          </a>
          <a
            href="tel:16105620971"
            class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
          >
            610-562-0971
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/IMG_4535-320.webp"
            alt="KRE Security patrol vehicle"
            class="w-full max-w-[320px] h-48 object-cover"
            loading="eager"
          />
        </div>
        <div class="tactical-frame overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/Rav-4-pic-for-proposals-320.webp"
            alt="KRE Security RAV4 patrol vehicle"
            class="w-full max-w-[320px] h-48 object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
