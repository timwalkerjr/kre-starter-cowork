---
<section class="bg-dark-background py-20 border-b border-dark-border">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <div class="reveal-left">
        <p class="status-dot mb-4">[ Industrial Security Division ]</p>
        <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-h1 mb-6 leading-tight">
          Warehouse &amp; Distribution Center Security
        </h1>
        <p class="font-sans text-dark-muted-foreground text-lg leading-relaxed mb-8">
          KRE has extensive experience providing security programs and services to distribution center clients. We demonstrate a vast understanding of the unique challenges and common concerns associated with this market.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
          >
            Contact Us Today
          </a>
          <a
            href="tel:6105620971"
            class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors"
          >
            610-562-0971
          </a>
        </div>
      </div>

      <!-- Images -->
      <div class="flex flex-col sm:flex-row lg:flex-col gap-4 reveal-right">
        <div class="tactical-frame border-dark-border overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/Truck-and-Warehouse-320.webp"
            alt="Truck and warehouse facility secured by KRE Security"
            class="max-w-[320px] h-auto object-cover"
            loading="eager"
          />
        </div>
        <div class="tactical-frame border-dark-border overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/20220228_124523-320.webp"
            alt="KRE Security distribution center patrol"
            class="max-w-[320px] h-auto object-cover"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </div>
</section>
