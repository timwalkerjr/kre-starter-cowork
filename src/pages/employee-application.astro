---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ApplicationContent from '@/components/employee-application/ApplicationContent.astro';
import { pageGraph } from '@/lib/schema';
const jsonLd = pageGraph(Astro.site.href, { name: 'Employee Application', path: '/employee-application/' });
---
<BaseLayout
  jsonLd={jsonLd}
  title="Security Positions Available! Apply Here - KRE Security"
  description="KRE Security LLC. is currently hiring for Full and Part Time Security agents and for Seasonal Security positions across the region."
>
  <ApplicationContent />
</BaseLayout>
