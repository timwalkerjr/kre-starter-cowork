---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmploymentHero from '@/components/employment/EmploymentHero.astro';
import EmploymentDetails from '@/components/employment/EmploymentDetails.astro';
import EmploymentApplication from '@/components/employment/EmploymentApplication.astro';
import { pageGraph } from '@/lib/schema';
// WebPage only — no JobPosting: we have no verified openings, titles, or
// salary data, and fabricating them would be false structured data.
const jsonLd = pageGraph(Astro.site.href, { name: 'Employment', path: '/employment/' });
---
<BaseLayout
  jsonLd={jsonLd}
  title="Security Company Employment | Eastern Pennsylvania | KRE Security"
  description="KRE Security LLC. is currently hiring for Full/Part Time Security agents and for Seasonal Security positions across the region."
>
  <EmploymentHero />
  <EmploymentDetails />
  <EmploymentApplication />
</BaseLayout>
