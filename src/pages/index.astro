---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Trust from '@/components/home/Trust.astro';
import Services from '@/components/home/Services.astro';
import Advantages from '@/components/home/Advantages.astro';
import Coverage from '@/components/home/Coverage.astro';
import ContactForm from '@/components/home/ContactForm.astro';
import { SITE } from '@/config/site';
import { homeGraph } from '@/lib/schema';

const jsonLd = homeGraph(Astro.site.href);
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <Hero />
  <Services />
  <Trust />
  <Advantages />
  <Coverage />
  <ContactForm />
</BaseLayout>
