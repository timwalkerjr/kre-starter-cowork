---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "6 KRE School Security Division Members Just Attended ACT 67 Training";
const description = "Six KRE Security members, including management, completed ACT 67 School Security Personnel training at the BCIU Berks County Intermediate Unit in Reading, PA.";

const relatedPosts = [
  {
    href: "/post/firefighting-siblings-sister-succeeds-brother-as-department-s-new-chief/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_2f819f062c744b6abdbc5cf4c3d2c77c~mv2-289.webp",
    title: "'Firefighting siblings': Sister succeeds brother as department's new chief",
  },
  {
    href: "/post/wfmz-jewish-community-in-berks-gathers-for-yom-kippur-amid-violence-overseas/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_3e2acdced9ee48b1818600424b0380e9~mv2-289.webp",
    title: "WFMZ: Jewish community in Berks gathers for Yom Kippur amid violence overseas",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Post Hero -->
  <section class="bg-background border-b border-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <a href="/blog/" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors mb-8 font-display">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to News
      </a>
      <div class="mb-4">
        <span class="status-dot text-xs">[ Dispatch: Active Report ]</span>
      </div>
      <h1 class="font-display font-bold uppercase text-h2 leading-tight text-foreground mb-6">
        6 KRE School Security Division Members Just Attended ACT 67 Training
      </h1>
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <span class="uppercase tracking-widest text-xs font-bold font-display">KRE Security News</span>
      </div>
    </div>
  </section>

  <!-- Post Body -->
  <section class="bg-surface">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <div class="space-y-6 font-sans text-foreground leading-relaxed">

        <p class="text-lg">
          Six members of the KRE School Security Division, including management, just attended training at the BCIU Berks County Intermediate Unit in Reading, PA as part of the PA ACT 67 training for deployment as Armed Security in several districts KRE provides services to.
        </p>

        <div class="border border-primary bg-background p-6 my-8 tactical-frame">
          <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ PA State Mandate — ACT 67 Compliance ]</p>
          <p class="mb-3">
            Pennsylvania has mandated that all schools comply with <strong>ACT 67 School Security Personnel Law</strong>, which requires school security guards to complete the Basic School Resource Officer Course of Instruction offered by the National Association of School Resource Officers (NASRO) or an equivalent approved by the Pennsylvania Commission on Crime and Delinquency (PCCD).
          </p>
          <a
            href="https://www.psba.org/2019/07/act-67-of-2019-school-security-personnel/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold uppercase tracking-widest font-display text-primary underline hover:no-underline"
          >
            Learn more about ACT 67 of 2019 &rarr;
          </a>
        </div>

        <p>
          KRE meets this training requirement for our full-time, day-to-day Armed Security team, which provides large-scale services to school security guards in the districts we serve across the Eastern PA region.
        </p>

        <p>
          This compliance allows our clients to remain within state requirements and enables us to provide full-scale protection of students, staff, and guests who visit the districts we serve.
        </p>

        <div class="tactical-frame my-10 overflow-hidden">
          <img
            src="https://pagesmith-cdn.com/d22f750a/images/63861c_32853a3ba0cc434abd81bdcfe3e6105a~mv2_d_2048_1365_s_2-640.webp"
            alt="KRE School Security Division ACT 67 Training at BCIU Reading PA"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="bg-foreground px-4 py-2">
            <p class="text-xs font-bold uppercase tracking-widest font-display text-background">
              [ ACT 67 Training — BCIU Berks County Intermediate Unit, Reading, PA ]
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-8">
          <div class="border border-border bg-background p-5">
            <p class="text-2xl font-bold font-display text-primary mb-1">6</p>
            <p class="text-xs uppercase tracking-widest font-display font-bold text-muted-foreground">Members Trained</p>
          </div>
          <div class="border border-border bg-background p-5">
            <p class="text-2xl font-bold font-display text-primary mb-1">ACT 67</p>
            <p class="text-xs uppercase tracking-widest font-display font-bold text-muted-foreground">PA State Certification</p>
          </div>
          <div class="border border-border bg-background p-5">
            <p class="text-2xl font-bold font-display text-primary mb-1">NASRO</p>
            <p class="text-xs uppercase tracking-widest font-display font-bold text-muted-foreground">Nationally Recognized</p>
          </div>
        </div>

        <div class="border border-border bg-background p-6 my-8">
          <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ Learn More About ACT 67 Services ]</p>
          <p class="mb-4 text-sm">KRE Security is fully ACT 67 certified and ready to provide compliant, professional school security guard services across Eastern Pennsylvania.</p>
          <a href="/act-67-certified-services/" class="inline-block border-2 border-foreground bg-foreground text-background px-6 py-3 text-sm font-bold uppercase tracking-widest font-display hover:bg-primary hover:border-primary hover:text-foreground transition-colors">
            ACT 67 Certified Services &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  <section class="bg-dark-background border-t border-dark-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <div class="mb-8">
        <span class="text-xs font-bold uppercase tracking-widest font-display text-dark-muted-foreground">[ Related Reports ]</span>
        <h2 class="font-display font-bold uppercase text-h3 text-dark-foreground mt-2">More from KRE Security</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {relatedPosts.map((post) => (
          <a
            href={post.href}
            class="group bg-secondary border border-dark-border block overflow-hidden hover:border-primary transition-colors tactical-frame dark"
          >
            <div class="overflow-hidden">
              <img
                src={post.img}
                alt={post.title}
                class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <p class="text-sm font-bold text-dark-foreground font-display uppercase leading-snug group-hover:text-primary transition-colors">
                {post.title}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
