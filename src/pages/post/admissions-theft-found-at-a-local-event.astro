---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Admissions Theft Found at a Local Event";
const description = "KRE Security's Gate Team detected admissions theft at a Reading, PA event through proper screening, safety inspections, and ID verification procedures.";

const relatedPosts = [
  {
    href: "/post/firefighting-siblings-sister-succeeds-brother-as-department-s-new-chief/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_2f819f062c744b6abdbc5cf4c3d2c77c~mv2-289.webp",
    title: "'Firefighting siblings': Sister succeeds brother as department's new chief",
  },
  {
    href: "/post/wfmz-jewish-community-in-berks-gathers-for-yom-kippur-amid-violence-overseas/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_3e2acdced9ee48b1818600424b0380e9~mv2-289.webp",
    title: "WFMZ: Jewish community in Berks gathers for Yom Kippur amid violence overseas",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Post Hero -->
  <section class="bg-background border-b border-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <a href="/blog/" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors mb-8 font-display">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to News
      </a>
      <div class="mb-4">
        <span class="status-dot text-xs">[ Dispatch: Active Report ]</span>
      </div>
      <h1 class="font-display font-bold uppercase text-h2 leading-tight text-foreground mb-6">
        Admissions Theft Found at a Local Event
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
        <span class="uppercase tracking-widest text-xs font-bold font-display">KRE Security — Field Report</span>
        <span class="border border-primary text-primary text-xs font-bold uppercase tracking-widest font-display px-2 py-0.5">Reading, PA</span>
      </div>
    </div>
  </section>

  <!-- Post Body -->
  <section class="bg-surface">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">

      <div class="border border-primary bg-background p-6 mb-8 tactical-frame">
        <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ Incident Report — Event Security, Reading PA ]</p>
        <p class="text-lg font-sans leading-relaxed text-foreground">
          Admissions theft was found at a local event we were assigned to in Reading, PA, due to proper screening by the KRE Gate Team performing safety inspections and ID verification processes.
        </p>
      </div>

      <div class="tactical-frame mb-10 overflow-hidden">
        <img
          src="https://pagesmith-cdn.com/d22f750a/images/63861c_868da01a17d442288157703867f3b154~mv2-320.webp"
          alt="KRE Security event gate team on duty at Reading PA event"
          class="max-w-[320px] h-auto object-cover mx-auto block"
          loading="lazy"
        />
      </div>

      <div class="space-y-6 font-sans text-foreground leading-relaxed">

        <p>
          We pride ourselves in the identification of anyone who may try to be fraudulent at our events. This successful intercept demonstrates the effectiveness of KRE Security's rigorous event security protocols — including multi-layer gate screening, comprehensive safety inspections, and thorough ID verification procedures.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-8">
          <div class="border border-border bg-background p-5 tactical-frame">
            <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-2">[ Gate Screening ]</p>
            <p class="text-sm text-muted-foreground">Comprehensive entry screening for all attendees to ensure event integrity and public safety.</p>
          </div>
          <div class="border border-border bg-background p-5 tactical-frame">
            <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-2">[ ID Verification ]</p>
            <p class="text-sm text-muted-foreground">Rigorous identity confirmation processes to prevent fraud and unauthorized entry at all controlled access points.</p>
          </div>
          <div class="border border-border bg-background p-5 tactical-frame">
            <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-2">[ Safety Inspections ]</p>
            <p class="text-sm text-muted-foreground">Full safety inspections performed by trained KRE Gate Teams to maintain secure event perimeters.</p>
          </div>
        </div>

        <p>
          KRE Security's event staffing services go beyond simple crowd management. Our professional Gate Teams are trained to identify fraudulent activity, enforce admission protocols, and maintain the overall security and integrity of every event we serve — from community gatherings to large-scale public events across Eastern Pennsylvania.
        </p>

        <div class="border border-border bg-background p-6 my-8">
          <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ Event Staffing Services ]</p>
          <p class="mb-4 text-sm">
            Protect your event with professional KRE Security event staffing, including gate teams, traffic control, and armed or unarmed security personnel throughout Eastern Pennsylvania.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/school-event-staff/" class="inline-block border-2 border-foreground bg-foreground text-background px-5 py-2.5 text-sm font-bold uppercase tracking-widest font-display hover:bg-primary hover:border-primary hover:text-foreground transition-colors">
              Event Staffing &rarr;
            </a>
            <a href="/#contact" class="inline-block border-2 border-border text-foreground px-5 py-2.5 text-sm font-bold uppercase tracking-widest font-display hover:border-foreground transition-colors">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  <section class="bg-dark-background border-t border-dark-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <div class="mb-8">
        <span class="text-xs font-bold uppercase tracking-widest font-display text-dark-muted-foreground">[ Related Reports ]</span>
        <h2 class="font-display font-bold uppercase text-h3 text-dark-foreground mt-2">More from KRE Security</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {relatedPosts.map((post) => (
          <a
            href={post.href}
            class="group bg-secondary border border-dark-border block overflow-hidden hover:border-primary transition-colors tactical-frame dark"
          >
            <div class="overflow-hidden">
              <img
                src={post.img}
                alt={post.title}
                class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <p class="text-sm font-bold text-dark-foreground font-display uppercase leading-snug group-hover:text-primary transition-colors">
                {post.title}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
