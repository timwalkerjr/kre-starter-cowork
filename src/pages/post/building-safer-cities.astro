---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Building Safer Cities";
const description = "Safe City and Smart City projects are rapidly becoming an effective and proactive security strategy, enabling collaboration between city officials, security leaders, law enforcement, and first responders.";

const relatedPosts = [
  {
    href: "/post/firefighting-siblings-sister-succeeds-brother-as-department-s-new-chief/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_2f819f062c744b6abdbc5cf4c3d2c77c~mv2-289.webp",
    title: "'Firefighting siblings': Sister succeeds brother as department's new chief",
  },
  {
    href: "/post/wfmz-jewish-community-in-berks-gathers-for-yom-kippur-amid-violence-overseas/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_3e2acdced9ee48b1818600424b0380e9~mv2-289.webp",
    title: "WFMZ: Jewish community in Berks gathers for Yom Kippur amid violence overseas",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Post Hero -->
  <section class="bg-background border-b border-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <a href="/blog/" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors mb-8 font-display">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to News
      </a>
      <div class="mb-4">
        <span class="status-dot text-xs">[ Dispatch: Active Report ]</span>
      </div>
      <h1 class="font-display font-bold uppercase text-h2 leading-tight text-foreground mb-6">
        Building Safer Cities
      </h1>
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <span class="uppercase tracking-widest text-xs font-bold font-display">KRE Security — Industry Intelligence</span>
      </div>
    </div>
  </section>

  <!-- Post Body -->
  <section class="bg-surface">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">

      <div class="tactical-frame mb-10 overflow-hidden">
        <img
          src="https://pagesmith-cdn.com/d22f750a/images/9108a1b7cf744806a1d9a44eb0e7b75b-640.webp"
          alt="Building Safer Cities — Smart City Security Infrastructure"
          class="w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <div class="space-y-6 font-sans text-foreground leading-relaxed">

        <p class="text-lg">
          Safe City, or Smart City, projects are rapidly becoming an ideal way to build an effective and proactive security strategy while allowing increased collaboration between city officials, security leaders, law enforcement, and first responders.
        </p>

        <p>
          Close partnerships between these parties enable cities to efficiently identify current threats while learning and analyzing data points to be best prepared to address future risks.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
          <div class="border border-border bg-background p-6 tactical-frame">
            <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ Situational Awareness ]</p>
            <p class="text-sm">Safe City initiatives help cities achieve true situational awareness—both in regular times and during emergency situations—by aggregating a significant amount of data and turning it into actionable intelligence.</p>
          </div>
          <div class="border border-border bg-background p-6 tactical-frame">
            <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ Actionable Intelligence ]</p>
            <p class="text-sm">Correlated information enables officials to quickly and efficiently identify threats, manage emergency situations, and investigate incidents before they escalate.</p>
          </div>
        </div>

        <p>
          The correlated information then enables officials to quickly and efficiently identify threats, manage emergency situations, and investigate incidents. KRE Security understands the importance of this multi-layered approach to community safety and integrates these principles into the professional security services we offer across Eastern Pennsylvania.
        </p>

        <div class="border border-primary bg-background p-6 my-8">
          <p class="text-xs font-bold uppercase tracking-widest font-display text-primary mb-3">[ KRE Security — Your Total Security Professional ]</p>
          <p class="mb-4 text-sm">
            From vehicle patrols to event staffing and logistical security, KRE Security provides the professional presence and proactive strategies that contribute to safer communities throughout Pennsylvania.
          </p>
          <a href="/#services" class="inline-block border-2 border-foreground bg-foreground text-background px-6 py-3 text-sm font-bold uppercase tracking-widest font-display hover:bg-primary hover:border-primary hover:text-foreground transition-colors">
            View Our Services &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  <section class="bg-dark-background border-t border-dark-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <div class="mb-8">
        <span class="text-xs font-bold uppercase tracking-widest font-display text-dark-muted-foreground">[ Related Reports ]</span>
        <h2 class="font-display font-bold uppercase text-h3 text-dark-foreground mt-2">More from KRE Security</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {relatedPosts.map((post) => (
          <a
            href={post.href}
            class="group bg-secondary border border-dark-border block overflow-hidden hover:border-primary transition-colors tactical-frame dark"
          >
            <div class="overflow-hidden">
              <img
                src={post.img}
                alt={post.title}
                class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <p class="text-sm font-bold text-dark-foreground font-display uppercase leading-snug group-hover:text-primary transition-colors">
                {post.title}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
