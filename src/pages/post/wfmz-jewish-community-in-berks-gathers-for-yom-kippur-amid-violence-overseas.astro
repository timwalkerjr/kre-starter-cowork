---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "WFMZ: Jewish Community in Berks Gathers for Yom Kippur Amid Violence Overseas";
const description = "KRE Security contracted by temples throughout Berks, Lehigh, Carbon and surrounding counties to provide protection during religious services.";

const relatedPosts = [
  {
    href: "/post/firefighting-siblings-sister-succeeds-brother-as-department-s-new-chief/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_2f819f062c744b6abdbc5cf4c3d2c77c~mv2-289.webp",
    title: "'Firefighting siblings': Sister succeeds brother as department's new chief",
  },
  {
    href: "/post/6-kre-school-security-division-just-attended/",
    img: "https://pagesmith-cdn.com/d22f750a/images/63861c_32853a3ba0cc434abd81bdcfe3e6105a~mv2_d_2048_1365_s_2-289.webp",
    title: "6 KRE School Security Division just attended...",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Post Hero -->
  <section class="bg-background border-b border-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <a href="/blog/" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors mb-8 font-display">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to News
      </a>
      <div class="mb-4">
        <span class="status-dot text-xs">[ Dispatch: Active Report ]</span>
      </div>
      <h1 class="font-display font-bold uppercase text-h2 leading-tight text-foreground mb-6">
        WFMZ: Jewish Community in Berks Gathers for Yom Kippur Amid Violence Overseas
      </h1>
      <div class="flex items-center gap-4 text-sm text-muted-foreground font-sans">
        <span class="uppercase tracking-widest text-xs font-bold font-display">KRE Security News</span>
      </div>
    </div>
  </section>

  <!-- Post Body -->
  <section class="bg-surface">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <div class="tactical-frame p-0 mb-10 overflow-hidden">
        <img
          src="https://pagesmith-cdn.com/d22f750a/images/63861c_3e2acdced9ee48b1818600424b0380e9~mv2-640.webp"
          alt="WFMZ News: Jewish community gathers for Yom Kippur"
          class="w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <div class="prose prose-slate max-w-none font-sans text-foreground">
        <p class="text-lg leading-relaxed mb-6">
          <a
            href="https://www.wfmz.com/news/area/berks/jewish-community-in-berks-gathers-for-yom-kippur-amid-violence-overseas/article_987eceee-42bc-4fcc-a5e9-4cf9c58465be.html"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block border-2 border-foreground bg-foreground text-background px-6 py-3 text-sm font-bold uppercase tracking-widest font-display hover:bg-primary hover:border-primary hover:text-foreground transition-colors"
          >
            View Full Article on WFMZ &rarr;
          </a>
        </p>

        <blockquote class="border-l-4 border-primary pl-6 my-8 bg-background p-6">
          <p class="text-base leading-relaxed italic text-foreground mb-3">
            "We've been contracted by various temples throughout the Berks, Lehigh, Carbon and surrounding counties for a number of years."
          </p>
          <footer class="text-sm font-bold uppercase tracking-widest font-display text-muted-foreground">
            — Jarrod Emes, KRE Security
          </footer>
        </blockquote>

        <p class="text-base leading-relaxed mb-6">
          "We're here to provide protection so that folks can pray and seek out their religious beliefs in peace and serenity and to protect everyone so they can practice."
        </p>

        <p class="text-base leading-relaxed mb-6">
          KRE Security has a long-standing presence protecting houses of worship and religious gatherings across Eastern Pennsylvania, providing professional, discreet security personnel who ensure that communities can observe their religious traditions safely.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  <section class="bg-dark-background border-t border-dark-border">
    <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
      <div class="mb-8">
        <span class="text-xs font-bold uppercase tracking-widest font-display text-dark-muted-foreground">[ Related Reports ]</span>
        <h2 class="font-display font-bold uppercase text-h3 text-dark-foreground mt-2">More from KRE Security</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {relatedPosts.map((post) => (
          <a
            href={post.href}
            class="group tactical-frame dark bg-secondary border border-dark-border block overflow-hidden hover:border-primary transition-colors"
          >
            <div class="overflow-hidden">
              <img
                src={post.img}
                alt={post.title}
                class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <p class="text-sm font-bold text-dark-foreground font-display uppercase leading-snug group-hover:text-primary transition-colors">
                {post.title}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
