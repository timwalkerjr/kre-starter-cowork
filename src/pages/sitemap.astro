---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';

const coreServices = [
  { title: 'Security Services PA', href: '/security-services-pa' },
  { title: 'Security Guards PA', href: '/security-guards-pa' },
  { title: 'Armed Security PA', href: '/armed-security-pa' },
  { title: 'Armed Security Guards Quakertown PA', href: '/armed-security-guards-quakertown-pa' },
  { title: 'Vehicle Patrol', href: '/vehicle-patrol' },
  { title: 'Security Checks', href: '/security-checks' },
  { title: 'School Security', href: '/school-security' },
];

const specializedSecurity = [
  { title: 'Logistical Security', href: '/logistical-security' },
  { title: 'Warehouse & Distribution Security', href: '/warehouse-distribution-security' },
  { title: 'Fire Watch', href: '/fire-watch' },
  { title: 'School Event Staff', href: '/school-event-staff' },
  { title: 'Event Traffic Control', href: '/event-traffic-control' },
  { title: 'Armed Money Escorts', href: '/armed-money-escorts' },
  { title: 'In-Home Security', href: '/in-home-security' },
  { title: 'Private Investigations', href: '/private-investigations' },
  { title: 'Process Services', href: '/process-services' },
  { title: 'First Aid Training', href: '/first-aid-training' },
  { title: 'ACT 67 Certified Services', href: '/act-67-certified-services' },
];

const companyInformation = [
  { title: 'Home', href: '/' },
  { title: 'Security Company FAQ', href: '/security-company-faq' },
  { title: 'Employment', href: '/employment' },
  { title: 'Employee Application', href: '/employee-application' },
  { title: 'Contact', href: '/contact' },
  { title: 'Blog', href: '/blog' },
];

const blogPosts = [
  { title: 'KRE School Security Division Just Attended', href: '/post/6-kre-school-security-division-just-attended' },
  { title: 'Admissions Theft Found at a Local Event', href: '/post/admissions-theft-found-at-a-local-event' },
  { title: 'Building Safer Cities', href: '/post/building-safer-cities' },
  { title: 'Firefighting Siblings', href: '/post/firefighting-siblings-sister-succeeds-brother-as-department-s-new-chief' },
  { title: 'In Aftermath of Parkland Fla. Shooting', href: '/post/in-aftermath-of-parkland-fla-shooting-lehigh-valley-school-districts-answer-call-to-add-armed' },
  { title: 'Palmerton Reports on Armed Officers in Schools', href: '/post/palmerton-reports-on-armed-officers-in-schools' },
  { title: 'Yom Kippur Amid Violence Overseas', href: '/post/wfmz-jewish-community-in-berks-gathers-for-yom-kippur-amid-violence-overseas' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Sitemap | KRE Security",
  "description": "Complete list of pages on the KRE Security website.",
  "url": "https://www.kresecurity.com/sitemap"
};
---

<BaseLayout title="Sitemap | KRE Security" description="Complete list of pages on the KRE Security website." jsonLd={jsonLd}>
  <section class="py-24 bg-surface" data-ps="src/pages/sitemap.astro:s1">
    <Container>
      <div class="max-w-4xl mx-auto" data-ps="src/pages/sitemap.astro:s2">
        <h1 class="text-h1 mb-12 border-b border-primary pb-4" data-ps="src/pages/sitemap.astro:s3">Site Map</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16" data-ps="src/pages/sitemap.astro:s4">
          <!-- Core Services -->
          <div data-ps="src/pages/sitemap.astro:s5">
            <h2 class="text-h3 mb-6 flex items-center gap-3" data-ps="src/pages/sitemap.astro:s6">
              <span class="w-8 h-px bg-primary" data-ps="src/pages/sitemap.astro:ky81yk"></span>
              Core Services
            </h2>
            <ul class="space-y-4 mb-12" data-ps="src/pages/sitemap.astro:s7">
              {coreServices.map(page => (
                <li data-ps="src/pages/sitemap.astro:s8">
                  <a href={page.href} class="text-lg font-display font-bold text-foreground hover:text-primary transition-colors flex items-center gap-2 group" data-ps="src/pages/sitemap.astro:k2o1ia">
                    <svg class="w-4 h-4 text-primary opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>

            <!-- Company Info -->
            <h2 class="text-h3 mb-6 flex items-center gap-3" data-ps="src/pages/sitemap.astro:s13">
              <span class="w-8 h-px bg-primary" data-ps="src/pages/sitemap.astro:ky81ym"></span>
              Company Info
            </h2>
            <ul class="space-y-4" data-ps="src/pages/sitemap.astro:s14">
              {companyInformation.map(page => (
                <li data-ps="src/pages/sitemap.astro:s15">
                  <a href={page.href} class="text-lg font-display font-bold text-foreground hover:text-primary transition-colors flex items-center gap-2 group" data-ps="src/pages/sitemap.astro:k2o1ic">
                    <svg class="w-4 h-4 text-primary opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          
          <div data-ps="src/pages/sitemap.astro:s9">
            <!-- Specialized Security -->
            <h2 class="text-h3 mb-6 flex items-center gap-3" data-ps="src/pages/sitemap.astro:s16">
              <span class="w-8 h-px bg-primary" data-ps="src/pages/sitemap.astro:ky81yn"></span>
              Specialized Security
            </h2>
            <ul class="space-y-4 mb-12" data-ps="src/pages/sitemap.astro:s17">
              {specializedSecurity.map(page => (
                <li data-ps="src/pages/sitemap.astro:s18">
                  <a href={page.href} class="text-lg font-display font-bold text-foreground hover:text-primary transition-colors flex items-center gap-2 group" data-ps="src/pages/sitemap.astro:k2o1id">
                    <svg class="w-4 h-4 text-primary opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>

            <!-- News & Updates -->
            <h2 class="text-h3 mb-6 flex items-center gap-3" data-ps="src/pages/sitemap.astro:s10">
              <span class="w-8 h-px bg-primary" data-ps="src/pages/sitemap.astro:ky81yl"></span>
              News & Updates
            </h2>
            <ul class="space-y-4" data-ps="src/pages/sitemap.astro:s11">
              {blogPosts.map(post => (
                <li data-ps="src/pages/sitemap.astro:s12">
                  <a href={post.href} class="text-lg font-display font-bold text-foreground hover:text-primary transition-colors flex items-center gap-2 group" data-ps="src/pages/sitemap.astro:k2o1ib">
                    <svg class="w-4 h-4 text-primary opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {post.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
