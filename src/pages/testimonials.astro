---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TestimonialsHero from '@/components/testimonials/TestimonialsHero.astro';

const entries = await getCollection('reviews', ({ data }) => !data.draft);
const testimonials = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---
<BaseLayout
  title="Testimonials | KRE Security"
  description="See what our clients say about KRE Security's professional security guard and investigation services across Eastern Pennsylvania."
>
  <TestimonialsHero />

  <section class="bg-background py-20">
    <div class="max-w-7xl mx-auto px-6">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {testimonials.map(({ entry, Content }, i) => (
          <div
            class="tactical-frame bg-surface p-8 flex flex-col reveal"
            style={`transition-delay: ${i * 0.1}s`}
          >
            <!-- Quote mark -->
            <div class="text-primary font-display text-5xl font-bold leading-none mb-4 select-none" aria-hidden="true">"</div>

            <blockquote class="font-sans text-foreground text-sm leading-relaxed flex-1 mb-6 [&>p]:m-0">
              <Content />
            </blockquote>

            <footer class="border-t border-border pt-4">
              <p class="font-display font-bold text-foreground text-sm uppercase tracking-wide">
                — {entry.data.author}
              </p>
              {entry.data.authorContext && (
                <p class="font-sans text-muted-foreground text-xs mt-1">
                  {entry.data.authorContext}
                </p>
              )}
            </footer>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center border border-border bg-surface p-10 reveal">
        <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-3">
          [ Share Your Experience ]
        </p>
        <h2 class="font-display font-bold uppercase text-foreground text-h3 mb-4">
          Let Us Know Your Experience with KRE Security
        </h2>
        <p class="font-sans text-muted-foreground text-sm mb-6">
          Your feedback helps us continue to improve our services.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://www.facebook.com/KREsecinvestigations/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-foreground text-background font-display font-bold uppercase tracking-widest text-xs px-6 py-3 border-2 border-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors"
          >
            Review on Facebook
          </a>
          <a
            href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.986583,17z"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-transparent text-foreground font-display font-bold uppercase tracking-widest text-xs px-6 py-3 border-2 border-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors"
          >
            Review on Google
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
